{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bank.internal/schemas/shared-document-metadata-v1.json",
  "title": "SharedDocumentMetadataV1",
  "type": "object",
  "required": [
    "annotation_schema",
    "document_id",
    "document_class",
    "application_version",
    "metadata_revision",
    "schema_version",
    "content_type",
    "content_length",
    "content_checksum",
    "filename",
    "created_at",
    "created_by",
    "customer_id",
    "complete_customer_id_code",
    "account_id",
    "business_area_code",
    "business_sub_area_code"
  ],
  "properties": {
    "annotation_schema": {
      "type": "string"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_class": {
      "type": "string"
    },
    "application_version": {
      "type": "integer",
      "minimum": 1
    },
    "metadata_revision": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "content_type": {
      "type": "string",
      "minLength": 1
    },
    "content_length": {
      "type": "integer",
      "minimum": 1
    },
    "content_checksum": {
      "type": "string"
    },
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "metadata_updated_at": {
      "type": "string"
    },
    "metadata_updated_by": {
      "type": "string"
    },
    "customer_id": {
      "type": "integer",
      "minimum": 0,
      "description": "CUSTOMER_ID NUMBER(10)"
    },
    "complete_customer_id_code": {
      "type": "object",
      "description": "COMPLEATE_CUSTOMER_ID_CODE Compound Key",
      "required": ["id_number", "id_type"],
      "properties": {
        "id_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "ID_Number VARCHAR2(16)"
        },
        "id_type": {
          "type": "integer",
          "minimum": 0,
          "description": "ID_Type NUMBER(10)"
        }
      },
      "additionalProperties": false
    },
    "account_id": {
      "type": "object",
      "description": "ACCOUNT_ID Compound Key",
      "required": ["bank_id", "branch_id", "account_number"],
      "properties": {
        "bank_id": {
          "type": "integer",
          "minimum": 0,
          "description": "ACCOUNT_BANK_ID NUMBER(10)"
        },
        "branch_id": {
          "type": "integer",
          "minimum": 0,
          "description": "BRANCH_ID NUMBER(10)"
        },
        "account_number": {
          "type": "integer",
          "minimum": 0,
          "description": "ACCOUNT_NBR NUMBER(10)"
        }
      },
      "additionalProperties": false
    },
    "account_subscription_num": {
      "type": "integer",
      "minimum": 0,
      "description": "ACCOUNT_SUBSCRIPTION_NUM NUMBER(10)"
    },
    "transaction_id": {
      "type": "string",
      "maxLength": 64,
      "description": "TRANSACTION_ID"
    },
    "document_int": {
      "type": "string",
      "maxLength": 64,
      "description": "DOCUMENT_INT VARCHAR2(64) (DCTM)"
    },
    "document_ext": {
      "type": "string",
      "maxLength": 40,
      "description": "DOCUMENT_EXT VARCHAR2(40) (LEGACY)"
    },
    "a_content_type": {
      "type": "string",
      "maxLength": 32,
      "description": "A_CONTENT_TYPE VARCHAR2(32)"
    },
    "document_form_id": {
      "type": "string",
      "maxLength": 10,
      "description": "DOCUMENT_FORM_ID VARCHAR2(10)"
    },
    "legacy_document_entry_dttm": {
      "type": "string",
      "description": "LEGACY_DOCUMENT_ENTRY_DTTM DATE"
    },
    "r_creation_date": {
      "type": "string",
      "description": "R_CREATION_DATE DATE"
    },
    "r_modify_date": {
      "type": "string",
      "description": "R_MODIFY_DATE DATE"
    },
    "business_area_code": {
      "type": "integer",
      "minimum": 0,
      "description": "BUSINESS_AREA_CODE NUMBER(10)"
    },
    "business_sub_area_code": {
      "type": "integer",
      "minimum": 0,
      "description": "BUSINESS_SUB_AREA_CODE NUMBER(10)"
    },
    "document_group_id": {
      "type": "string",
      "maxLength": 40,
      "description": "DOCUMENT_GROUP_ID VARCHAR2(40)"
    }
  }
}
