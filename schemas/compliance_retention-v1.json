{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bank.document-metadata/compliance_retention/1",
  "title": "ComplianceRetentionMetadataV1",
  "allOf": [
    { "$ref": "https://bank.internal/schemas/shared-document-metadata-v1.json" },
    {
      "type": "object",
      "required": [
        "document_type",
        "retention_schedule_code",
        "retention_period_years",
        "regulatory_framework",
        "retention_start_date",
        "retention_expiry_date",
        "legal_hold_active",
        "disposal_action",
        "compliance_officer_id"
      ],
      "properties": {
        "annotation_schema": {
          "type": "string",
          "const": "bank.document-metadata/compliance_retention/1"
        },
        "document_class": {
          "type": "string",
          "const": "compliance_retention"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "document_type": {
          "type": "string",
          "enum": [
            "STATUTORY_RECORD",
            "FINANCIAL_LEDGER",
            "AUDIT_EVIDENCE",
            "CONTRACT_ARCHIVE",
            "COMMUNICATION_LOG",
            "TAX_RECORD",
            "AUDIT_TRAIL"
          ],
          "default": "FINANCIAL_LEDGER"
        },
        "retention_schedule_code": {
          "type": "string",
          "pattern": "^RET-[A-Za-z0-9_-]+$",
          "default": "RET-FIN-001"
        },
        "retention_period_years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 7
        },
        "regulatory_framework": {
          "type": "string",
          "enum": [
            "SOX",
            "FINRA",
            "GDPR",
            "BASEL_III",
            "LOCAL_BANKING_DIRECTIVE",
            "HIPAA",
            "LOCAL_BANKING_REG"
          ],
          "default": "SOX"
        },
        "retention_start_date": {
          "type": "string",
          "default": "2026-08-31"
        },
        "retention_expiry_date": {
          "type": "string",
          "default": "2033-12-31"
        },
        "legal_hold_active": {
          "type": "boolean",
          "default": false
        },
        "legal_hold_case_id": {
          "type": "string"
        },
        "disposal_action": {
          "type": "string",
          "enum": [
            "PERMANENT_DELETE",
            "TRANSITION_TO_GLACIER",
            "ARCHIVE_GLACIER",
            "MANUAL_DISPOSAL_REVIEW",
            "REVIEW_REQUIRED"
          ],
          "default": "PERMANENT_DELETE"
        },
        "compliance_officer_id": {
          "type": "string",
          "minLength": 1,
          "default": "COMP-OFFICER-01"
        }
      }
    }
  ]
}