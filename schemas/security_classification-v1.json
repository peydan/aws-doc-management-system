{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bank.document-metadata/security_classification/1",
  "title": "SecurityClassificationMetadataV1",
  "allOf": [
    { "$ref": "https://bank.internal/schemas/shared-document-metadata-v1.json" },
    {
      "type": "object",
      "required": [
        "document_type",
        "confidentiality_tier",
        "contains_pii",
        "pii_categories",
        "minimum_clearance_role",
        "encryption_requirement",
        "export_restricted",
        "classification_owner"
      ],
      "properties": {
        "annotation_schema": {
          "type": "string",
          "const": "bank.document-metadata/security_classification/1"
        },
        "document_class": {
          "type": "string",
          "const": "security_classification"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "document_type": {
          "type": "string",
          "enum": [
            "CUSTOMER_RECORD",
            "INTERNAL_MEMO",
            "BOARD_RESOLUTION",
            "FINANCIAL_FORECAST",
            "SECURITY_ASSESSMENT",
            "PII_EXTRACT",
            "SYSTEM_CREDENTIAL"
          ],
          "default": "BOARD_RESOLUTION"
        },
        "confidentiality_tier": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED",
            "HIGHLY_CONFIDENTIAL"
          ],
          "default": "RESTRICTED"
        },
        "contains_pii": {
          "type": "boolean",
          "default": false
        },
        "pii_categories": {
          "type": "array",
          "default": ["NONE"],
          "items": {
            "type": "string",
            "enum": [
              "NATIONAL_ID",
              "FINANCIAL_ACCOUNT",
              "FINANCIAL_HISTORY",
              "BIOMETRIC",
              "CONTACT_INFO",
              "CREDIT_SCORE",
              "NONE"
            ]
          }
        },
        "minimum_clearance_role": {
          "type": "string",
          "enum": [
            "Document.Reader",
            "Document.Writer",
            "Document.MetadataEditor",
            "Document.Admin",
            "Compliance.Auditor",
            "Executive.Only"
          ],
          "default": "Document.Reader"
        },
        "encryption_requirement": {
          "type": "string",
          "enum": [
            "SSE_S3",
            "SSE_KMS_DEFAULT",
            "SSE_KMS_CUSTOM_KEY",
            "SSE_KMS_CUSTOMER_MANAGED",
            "DUAL_LAYER_KMS"
          ],
          "default": "SSE_KMS_DEFAULT"
        },
        "export_restricted": {
          "type": "boolean",
          "default": false
        },
        "classification_owner": {
          "type": "string",
          "minLength": 1,
          "default": "SEC-OPS-01"
        }
      }
    }
  ]
}