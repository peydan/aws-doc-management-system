{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bank.document-metadata/security_classification/1",
  "title": "SecurityClassificationMetadataV1",
  "type": "object",
  "required": [
    "annotation_schema",
    "document_id",
    "document_class",
    "application_version",
    "metadata_revision",
    "schema_version",
    "document_type",
    "confidentiality_tier",
    "contains_pii",
    "pii_categories",
    "minimum_clearance_role",
    "encryption_requirement",
    "data_residency_jurisdiction",
    "export_restricted",
    "classification_owner",
    "content_type",
    "content_length",
    "filename"
  ],
  "properties": {
    "annotation_schema": {
      "type": "string",
      "const": "bank.document-metadata/security_classification/1"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_class": {
      "type": "string",
      "const": "security_classification"
    },
    "application_version": {
      "type": "integer",
      "minimum": 1
    },
    "metadata_revision": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "document_type": {
      "type": "string",
      "enum": [
        "CUSTOMER_RECORD",
        "INTERNAL_MEMO",
        "BOARD_RESOLUTION",
        "FINANCIAL_FORECAST",
        "SECURITY_ASSESSMENT"
      ]
    },
    "confidentiality_tier": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED",
        "HIGHLY_CONFIDENTIAL"
      ]
    },
    "contains_pii": {
      "type": "boolean"
    },
    "pii_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "NATIONAL_ID",
          "FINANCIAL_ACCOUNT",
          "BIOMETRIC",
          "CONTACT_INFO",
          "CREDIT_SCORE",
          "NONE"
        ]
      }
    },
    "minimum_clearance_role": {
      "type": "string",
      "enum": [
        "Document.Reader",
        "Document.Writer",
        "Document.Admin",
        "Compliance.Auditor",
        "Executive.Only"
      ]
    },
    "encryption_requirement": {
      "type": "string",
      "enum": [
        "SSE_S3",
        "SSE_KMS_DEFAULT",
        "SSE_KMS_CUSTOM_KEY",
        "DUAL_LAYER_KMS"
      ]
    },
    "data_residency_jurisdiction": {
      "type": "string",
      "enum": [
        "IL",
        "EU",
        "US",
        "GLOBAL"
      ]
    },
    "export_restricted": {
      "type": "boolean"
    },
    "classification_owner": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string",
      "minLength": 1
    },
    "content_length": {
      "type": "integer",
      "minimum": 1
    },
    "content_checksum": {
      "type": "string"
    },
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "metadata_updated_at": {
      "type": "string"
    },
    "metadata_updated_by": {
      "type": "string"
    }
  },
  "additionalProperties": false
}