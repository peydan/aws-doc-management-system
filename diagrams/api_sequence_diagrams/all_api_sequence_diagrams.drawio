        <mxCell id="msg_21" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. POST /documents/{doc_id}/restore&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Path: document_id, Bearer JWT (Admin)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="195" as="sourcePoint" /><mxPoint x="490" y="195" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_22" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify Document.Admin role membership&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="220" as="sourcePoint" /><mxPoint x="300" y="220" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_23" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized (Admin)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Context verified&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="250" as="sourcePoint" /><mxPoint x="490" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_24" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke Restore Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;document_id passed&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="280" as="sourcePoint" /><mxPoint x="680" y="280" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_25" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. setDocumentStatus (ACTIVE)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;pk: DOC#{document_id}, sk: DOC, SET status = &#x27;ACTIVE&#x27;&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="310" as="sourcePoint" /><mxPoint x="870" y="310" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_26" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. DynamoDB Status Updated&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Document status restored to ACTIVE&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="345" as="sourcePoint" /><mxPoint x="680" y="345" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_27" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. GetObject (Authoritative Metadata)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Key: documents/{class}/{doc_id}.metadata.json&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="380" as="sourcePoint" /><mxPoint x="1060" y="380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_28" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. Metadata JSON Payload&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Reads full metadata annotation&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="415" as="sourcePoint" /><mxPoint x="680" y="415" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_29" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. indexDocument (Re-index Projection)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;PUT /doc-platform-search-index/_doc/{doc_id} with status=ACTIVE&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="450" as="sourcePoint" /><mxPoint x="1250" y="450" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_30" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10. 200 OK (Re-indexed)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Document is searchable again&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="490" as="sourcePoint" /><mxPoint x="680" y="490" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_31" value="&lt;b style=&quot;font-size:11px;&quot;&gt;11. 200 OK Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ document_id, status: &#x27;ACTIVE&#x27;, updated_at }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="530" as="sourcePoint" /><mxPoint x="490" y="530" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_32" value="&lt;b style=&quot;font-size:11px;&quot;&gt;12. 200 OK (Document Restored)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Document restored to active catalog&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="565" as="sourcePoint" /><mxPoint x="110" y="565" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legend_33" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Full Recovery:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Restores DynamoDB active state and re-populates OpenSearch index&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Metadata Integrity:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;S3 annotation metadata is preserved unchanged during deletion lifecycle&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#C0392B; font-size:11px;&quot;&gt;RBAC:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Restricted to Document.Admin&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="1290" height="52" as="geometry" /></mxCell>
