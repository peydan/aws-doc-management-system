        <mxCell id="act_20" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="674" y="280" width="12" height="390" as="geometry" /></mxCell>
        <mxCell id="msg_21" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. POST /uploads/{upload_id}/complete&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Path: upload_id (UUID/ULID session identifier)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="195" as="sourcePoint" /><mxPoint x="490" y="195" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_22" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify Document.Writer / Document.Admin permissions&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="220" as="sourcePoint" /><mxPoint x="300" y="220" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_23" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Claims context passed&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="250" as="sourcePoint" /><mxPoint x="490" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_24" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke Complete Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Path parameter upload_id&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="280" as="sourcePoint" /><mxPoint x="680" y="280" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_25" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. GetUploadSession&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;pk: UPLOAD#{upload_id}, sk: SESSION (verifies state == INITIATED)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="310" as="sourcePoint" /><mxPoint x="1060" y="310" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_26" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Session Item Returned&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Metadata envelope, doc_id, expected checksum&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="345" as="sourcePoint" /><mxPoint x="680" y="345" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_27" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. HeadObject (Verify Upload Exists)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Key: documents/{class}/{doc_id}&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="380" as="sourcePoint" /><mxPoint x="870" y="380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_28" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. 200 OK (S3 Version Metadata)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Returns s3_version_id, content length &amp; ETag&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="415" as="sourcePoint" /><mxPoint x="680" y="415" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_29" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. PutObject (Authoritative Annotation)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Key: documents/.../{doc_id}.metadata.json with version pointer&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="450" as="sourcePoint" /><mxPoint x="870" y="450" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_30" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10. 200 OK (Annotation ETag)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Metadata annotation committed to S3&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="485" as="sourcePoint" /><mxPoint x="680" y="485" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_31" value="&lt;b style=&quot;font-size:11px;&quot;&gt;11. commitDocumentCreation &amp; Update Session&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Insert DOC#{doc_id}, VER#000001 and set session state=ACTIVE&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="520" as="sourcePoint" /><mxPoint x="1060" y="520" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_32" value="&lt;b style=&quot;font-size:11px;&quot;&gt;12. DynamoDB Committed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Document activated with application_version: 1&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="560" as="sourcePoint" /><mxPoint x="680" y="560" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_33" value="&lt;b style=&quot;font-size:11px;&quot;&gt;13. 201 Created Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ document_id, application_version: 1, s3_version_id, status: &#x27;ACTIVE&#x27; }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="600" as="sourcePoint" /><mxPoint x="490" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_34" value="&lt;b style=&quot;font-size:11px;&quot;&gt;14. 201 Created (Activated)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Document activated &amp; queryable across platform&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="635" as="sourcePoint" /><mxPoint x="110" y="635" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="async_35" value="&lt;b style=&quot;font-size:11px; color:#880E4F;&quot;&gt;15. (Async) DDB Streams -&gt; SQS -&gt; Indexer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#666666;&quot;&gt;Projection indexed in OpenSearch Serverless&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;dashPattern=2 2;rounded=0;strokeColor=#AD1457;strokeWidth=1.8;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="675" as="sourcePoint" /><mxPoint x="1250" y="675" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legend_36" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Verification:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;HeadObject confirms direct S3 PUT completed before activation&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Atomicity:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;DynamoDB session state transition from INITIATED to ACTIVE&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#D35400; font-size:11px;&quot;&gt;Metadata:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;S3 annotation contains authoritative metadata JSON&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="1360" height="52" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
