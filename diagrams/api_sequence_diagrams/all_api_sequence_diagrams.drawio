        <mxCell id="part_s3_12" value="&lt;b style=&quot;font-size:12px; color:#1B5E20;&quot;&gt;Amazon S3 Bucket&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;doc-platform-mvp-docs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="105" width="140" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_s3_12" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2E7D32;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="853" y="65" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="line_s3_13" value="" style="edgeStyle=none;dashed=1;html=1;strokeColor=#2E7D32;strokeWidth=1.2;strokeOpacity=80;endArrow=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="157" as="sourcePoint" /><mxPoint x="870" y="790" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="part_dynamodb_14" value="&lt;b style=&quot;font-size:12px; color:#01579B;&quot;&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;doc-platform-mvp-control&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="105" width="140" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_dynamodb_14" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#0277BD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1043" y="65" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="line_dynamodb_15" value="" style="edgeStyle=none;dashed=1;html=1;strokeColor=#0277BD;strokeWidth=1.2;strokeOpacity=80;endArrow=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="157" as="sourcePoint" /><mxPoint x="1060" y="790" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="part_indexer_16" value="&lt;b style=&quot;font-size:12px; color:#880E4F;&quot;&gt;Async Indexer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;DDB Stream → SQS → OpenSearch&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1180" y="105" width="140" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_indexer_16" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#AD1457;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="1233" y="65" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="line_indexer_17" value="" style="edgeStyle=none;dashed=1;html=1;strokeColor=#AD1457;strokeWidth=1.2;strokeOpacity=80;endArrow=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="157" as="sourcePoint" /><mxPoint x="1250" y="790" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="act_18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="104" y="180" width="12" height="560" as="geometry" /></mxCell>
        <mxCell id="act_19" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="484" y="200" width="12" height="510" as="geometry" /></mxCell>
        <mxCell id="act_20" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="674" y="280" width="12" height="410" as="geometry" /></mxCell>
        <mxCell id="msg_21" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. POST /documents/{document_id}/versions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Binary payload, Content-Type: application/pdf&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="195" as="sourcePoint" /><mxPoint x="490" y="195" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_22" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify Document.Writer / Document.Admin&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="220" as="sourcePoint" /><mxPoint x="300" y="220" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_23" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Context verified&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="250" as="sourcePoint" /><mxPoint x="490" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_24" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke Create Version&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Event with binary body &amp; doc_id&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="280" as="sourcePoint" /><mxPoint x="680" y="280" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_25" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. GetItem (Current Doc State)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;pk: DOC#{document_id}, sk: DOC&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="310" as="sourcePoint" /><mxPoint x="1060" y="310" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_26" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Current Doc Details&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;current_application_version = 1, current_s3_key&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="340" as="sourcePoint" /><mxPoint x="680" y="340" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_27" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. GetObject (Existing Metadata)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Key: documents/{class}/{doc_id}.metadata.json&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="370" as="sourcePoint" /><mxPoint x="870" y="370" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_28" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. Metadata JSON&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Inherits existing business fields&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="400" as="sourcePoint" /><mxPoint x="680" y="400" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="self_29" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;9. Compute Checksum &amp; Increment Version&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#666666;&quot;&gt;SHA-256 calculation, next_version = 2, reset metadata_revision = 1&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#D35400;strokeWidth=1.3;fontSize=10.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="686" y="420" as="sourcePoint" /><mxPoint x="686" y="450" as="targetPoint" /><Array as="points"><mxPoint x="725" y="420" /><mxPoint x="725" y="450" /></Array></mxGeometry></mxCell>
        <mxCell id="msg_30" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10. PutObject (New Binary Content)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Key: documents/{class}/{doc_id} (Same S3 key)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="470" as="sourcePoint" /><mxPoint x="870" y="470" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_31" value="&lt;b style=&quot;font-size:11px;&quot;&gt;11. 200 OK (New S3 Version)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Header: x-amz-version-id (new native S3 version)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="505" as="sourcePoint" /><mxPoint x="680" y="505" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_32" value="&lt;b style=&quot;font-size:11px;&quot;&gt;12. PutObject (Updated Annotation)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Key: documents/.../{doc_id}.metadata.json (Points to new S3 version)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="535" as="sourcePoint" /><mxPoint x="870" y="535" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_33" value="&lt;b style=&quot;font-size:11px;&quot;&gt;13. 200 OK (Annotation ETag)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Annotation updated&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="565" as="sourcePoint" /><mxPoint x="680" y="565" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_34" value="&lt;b style=&quot;font-size:11px;&quot;&gt;14. TransactWrite (Atomic Version Promotion)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Update DOC (condition: version == 1) + Insert VER#000002&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="595" as="sourcePoint" /><mxPoint x="1060" y="595" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_35" value="&lt;b style=&quot;font-size:11px;&quot;&gt;15. Transaction Committed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Version 2 activated&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="635" as="sourcePoint" /><mxPoint x="680" y="635" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_36" value="&lt;b style=&quot;font-size:11px;&quot;&gt;16. 201 Created Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ document_id, application_version: 2, s3_version_id, metadata_revision: 1 }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="665" as="sourcePoint" /><mxPoint x="490" y="665" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_37" value="&lt;b style=&quot;font-size:11px;&quot;&gt;17. 201 Created (Version 2)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;New version registered&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="695" as="sourcePoint" /><mxPoint x="110" y="695" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="async_38" value="&lt;b style=&quot;font-size:11px; color:#880E4F;&quot;&gt;18. (Async) DDB Streams -&gt; OpenSearch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#666666;&quot;&gt;OpenSearch search index updated with new version pointer&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;dashPattern=2 2;rounded=0;strokeColor=#AD1457;strokeWidth=1.8;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="725" as="sourcePoint" /><mxPoint x="1250" y="725" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legend_39" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Version Keying:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Same S3 object key with native S3 versioning ID generation&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Optimistic Locking:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;TransactWrite condition protects against concurrent version creation&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#D35400; font-size:11px;&quot;&gt;Revision Reset:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;metadata_revision resets to 1 upon new binary version creation&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="810" width="1360" height="52" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="seq-09-get-version" name="09. GET /documents/{id}/versions/{ver}">
    <mxGraphModel dx="1450" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner_3" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:110px; vertical-align:middle;&quot;&gt;&lt;div style=&quot;background-color:#2E7D32; color:#FFFFFF; font-weight:bold; font-size:14px; text-align:center; padding:6px 12px; border-radius:4px;&quot;&gt;GET&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding-left:14px; vertical-align:middle;&quot;&gt;&lt;div style=&quot;font-size:18px; font-weight:bold; color:#232F3E;&quot;&gt;/documents/{document_id}/versions/{version}&lt;/div&gt;&lt;div style=&quot;font-size:12px; color:#5A6B7C; margin-top:2px;&quot;&gt;Retrieve Details &amp; Presigned Download URL for a Specific Historical Version &amp;nbsp;|&amp;nbsp; &lt;b style=&quot;color:#232F3E;&quot;&gt;Operation:&lt;/b&gt; &lt;code&gt;getVersion&lt;/code&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right; vertical-align:middle; width:340px;&quot;&gt;&lt;div style=&quot;background-color:#FFF8E1; border:1px solid #F39C12; border-radius:4px; padding:5px 10px; display:inline-block; font-size:11px; color:#7D6608;&quot;&gt;&lt;b&gt;RBAC:&lt;/b&gt; Document.Reader, Document.Writer, Document.MetadataEditor, Document.Admin&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1.5;align=left;spacingLeft=15;spacingRight=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1290" height="68" as="geometry" /></mxCell>
        <mxCell id="part_client_4" value="&lt;b style=&quot;font-size:12px; color:#263238;&quot;&gt;Client / Auditor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;Web UI / Historical Viewer&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="140" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_client_4" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#0277BD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="103" y="65" width="34" height="34" as="geometry" /></mxCell>
