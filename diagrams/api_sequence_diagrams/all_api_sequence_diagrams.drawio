        <mxCell id="msg_18" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify read permissions&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="220" as="sourcePoint" /><mxPoint x="390" y="220" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_19" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Context verified&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="250" as="sourcePoint" /><mxPoint x="650" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_20" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke List Versions Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;document_id passed&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="280" as="sourcePoint" /><mxPoint x="910" y="280" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_21" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. Query (Version Items)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;pk: DOC#{doc_id}, sk begins_with &#x27;VER#&#x27;, ScanIndexForward: false&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="310" as="sourcePoint" /><mxPoint x="1110" y="310" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_22" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Version Items Array&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Items: [{ application_version: 2, s3_version_id, checksum }, { version: 1... }]&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="355" as="sourcePoint" /><mxPoint x="910" y="355" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_23" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. 200 OK Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ document_id, versions: [ VersionItem, ... ] }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="410" as="sourcePoint" /><mxPoint x="650" y="410" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_24" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. 200 OK (Version History JSON)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Renders historical audit timeline&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="455" as="sourcePoint" /><mxPoint x="130" y="455" as="targetPoint" /></mxGeometry></mxCell>
