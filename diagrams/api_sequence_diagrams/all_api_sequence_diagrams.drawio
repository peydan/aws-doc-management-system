        <mxCell id="msg_13" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. GET /v1/health&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;HTTP/1.1 (Unauthenticated request)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="200" as="sourcePoint" /><mxPoint x="490" y="200" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_14" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Invoke Lambda Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Direct pass-through (No Cognito authorizer)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="230" as="sourcePoint" /><mxPoint x="830" y="230" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="self_15" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;3. Evaluate Health Status&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#666666;&quot;&gt;Check runtime memory &amp; system timestamp&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#D35400;strokeWidth=1.3;fontSize=10.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="836" y="270" as="sourcePoint" /><mxPoint x="836" y="310" as="targetPoint" /><Array as="points"><mxPoint x="875" y="270" /><mxPoint x="875" y="310" /></Array></mxGeometry></mxCell>
        <mxCell id="ret_16" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. 200 OK&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ status: &#x27;HEALTHY&#x27;, service: &#x27;doc-platform&#x27;, version: &#x27;0.1.0&#x27;, timestamp }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="380" as="sourcePoint" /><mxPoint x="490" y="380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_17" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. 200 OK Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;application/json payload with system metadata&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="440" as="sourcePoint" /><mxPoint x="150" y="440" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="note_18" value="&lt;b style=&quot;font-size:10.5px; color:#795548;&quot;&gt;Health SLA Check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#4E342E;&quot;&gt;Fast path without DB dependency. Used by Route53, container health probes, and synthetic monitors.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#FBC02D;strokeWidth=1.2;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="460" y="480" width="240" height="65" as="geometry" /></mxCell>
        <mxCell id="legend_19" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Security:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Public bypass, no JWT required&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Latency:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;&lt; 15ms target response time&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#7B1FA2; font-size:11px;&quot;&gt;Status Codes:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;200 OK (Healthy)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="990" height="52" as="geometry" /></mxCell>
