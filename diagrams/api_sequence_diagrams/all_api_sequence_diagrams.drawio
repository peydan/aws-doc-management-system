        <mxCell id="act_17" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="574" y="200" width="12" height="320" as="geometry" /></mxCell>
        <mxCell id="act_18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="804" y="280" width="12" height="220" as="geometry" /></mxCell>
        <mxCell id="msg_19" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. GET /documents/{doc_id}/download&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Optional Query: ?version=1 (defaults to latest active)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="195" as="sourcePoint" /><mxPoint x="580" y="195" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_20" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify read permissions&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="220" as="sourcePoint" /><mxPoint x="350" y="220" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_21" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Context verified&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="250" as="sourcePoint" /><mxPoint x="580" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_22" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke Download Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;doc_id &amp; version query param&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="280" as="sourcePoint" /><mxPoint x="810" y="280" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_23" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. GetItem (Resolve Version Pointer)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Query DOC or VER# depending on version parameter&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="310" as="sourcePoint" /><mxPoint x="1040" y="310" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_24" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Pointer Resolved&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;s3_key: documents/loan_agreement/{doc_id}, s3_version_id&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="345" as="sourcePoint" /><mxPoint x="810" y="345" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_25" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. Generate Presigned GET URL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Key: s3_key, VersionId: s3_version_id, Expires: 900s (15 min)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="380" as="sourcePoint" /><mxPoint x="1250" y="380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_26" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. Presigned GET URL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Signed HTTPS S3 URL returned&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="415" as="sourcePoint" /><mxPoint x="810" y="415" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_27" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. 200 OK Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ document_id, s3_version_id, download_url, expires_at }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="455" as="sourcePoint" /><mxPoint x="580" y="455" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_28" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10. 200 OK (Download Envelope)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Client receives direct S3 presigned URL&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="490" as="sourcePoint" /><mxPoint x="120" y="490" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="frame_29" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;Direct High-Speed Document Streaming&lt;/b&gt; &lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;[Client streams binary content directly from S3 (Zero APIGW/Lambda egress bottleneck)]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=140;height=22;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1.2;strokeOpacity=70;fillOpacity=40;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1160" height="160" as="geometry" /></mxCell>
        <mxCell id="msg_30" value="&lt;b style=&quot;font-size:11px;&quot;&gt;11. GET {download_url} (Direct S3 Request)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Direct HTTPS GET with SigV4 query signature&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="575" as="sourcePoint" /><mxPoint x="1250" y="575" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_31" value="&lt;b style=&quot;font-size:11px;&quot;&gt;12. 200 OK (Raw Binary Stream)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Content-Type: application/pdf / image/tiff / Office bytes&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="645" as="sourcePoint" /><mxPoint x="120" y="645" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legend_32" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Zero Bottleneck:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Direct S3 streaming avoids API Gateway 10MB payload limit and Lambda egress cost&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Version Pinning:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;S3 VersionId query param ensures exact version download regardless of new uploads&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#D35400; font-size:11px;&quot;&gt;Short Expiry:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;15-minute presigned TTL limits security exposure&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="1290" height="52" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
