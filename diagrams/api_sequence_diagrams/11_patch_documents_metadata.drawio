        <mxCell id="act_20" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="674" y="280" width="12" height="430" as="geometry" /></mxCell>
        <mxCell id="msg_21" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. PATCH /documents/{document_id}/metadata&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ expected_metadata_revision: 1, changes: { branch_code: &#x27;TLV-05&#x27; }, reason: &#x27;CORRECTION&#x27; }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="195" as="sourcePoint" /><mxPoint x="490" y="195" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_22" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify MetadataEditor, Writer, or Admin role&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="220" as="sourcePoint" /><mxPoint x="300" y="220" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_23" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Context verified&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="250" as="sourcePoint" /><mxPoint x="490" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_24" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke Update Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Payload &amp; expected_metadata_revision passed&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="280" as="sourcePoint" /><mxPoint x="680" y="280" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="self_25" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;5. Validate Mutable Fields&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#666666;&quot;&gt;Verify immutable fields (created_at, checksum, doc_id) are untouched&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#D35400;strokeWidth=1.3;fontSize=10.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="686" y="305" as="sourcePoint" /><mxPoint x="686" y="335" as="targetPoint" /><Array as="points"><mxPoint x="725" y="305" /><mxPoint x="725" y="335" /></Array></mxGeometry></mxCell>
        <mxCell id="msg_26" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. GetItem (Doc Revision Check)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;pk: DOC#{document_id}, sk: DOC&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="350" as="sourcePoint" /><mxPoint x="870" y="350" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_27" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. Current Doc State&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;current_metadata_revision: 1, current_s3_version_id&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="380" as="sourcePoint" /><mxPoint x="680" y="380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="frame_28" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;Conflict Detection (OCC)&lt;/b&gt; &lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;[If current_metadata_revision != expected_metadata_revision -&gt; 409 METADATA_CONFLICT]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=140;height=22;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1.2;strokeOpacity=70;fillOpacity=40;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="400" width="520" height="95" as="geometry" /></mxCell>
        <mxCell id="ret_29" value="&lt;b style=&quot;font-size:11px;&quot;&gt;Alt 409 METADATA_CONFLICT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Error: Expected revision mismatch. Returns { current_revision: 2 }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#C0392B;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="450" as="sourcePoint" /><mxPoint x="490" y="450" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_30" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. GetObject (Current Annotation)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Key: documents/{class}/{doc_id}.metadata.json&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="510" as="sourcePoint" /><mxPoint x="1060" y="510" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_31" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. Existing Annotation JSON&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Current business metadata&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="540" as="sourcePoint" /><mxPoint x="680" y="540" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="self_32" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;10. Merge Changes &amp; Increment Revision&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#666666;&quot;&gt;next_revision = 2, validate JSON Schema v1&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#D35400;strokeWidth=1.3;fontSize=10.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="686" y="560" as="sourcePoint" /><mxPoint x="686" y="590" as="targetPoint" /><Array as="points"><mxPoint x="725" y="560" /><mxPoint x="725" y="590" /></Array></mxGeometry></mxCell>
        <mxCell id="msg_33" value="&lt;b style=&quot;font-size:11px;&quot;&gt;11. PutObject (New Annotation JSON)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Key: documents/.../{doc_id}.metadata.json (Revision: 2)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="605" as="sourcePoint" /><mxPoint x="1060" y="605" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_34" value="&lt;b style=&quot;font-size:11px;&quot;&gt;12. 200 OK (New Annotation ETag)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;S3 annotation updated&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="635" as="sourcePoint" /><mxPoint x="680" y="635" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_35" value="&lt;b style=&quot;font-size:11px;&quot;&gt;13. updateMetadataRevision (Conditional)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;UpdateItem SET metadata_rev = 2 WHERE current_rev == 1&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="665" as="sourcePoint" /><mxPoint x="870" y="665" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_36" value="&lt;b style=&quot;font-size:11px;&quot;&gt;14. Conditional Update OK&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Revision 2 committed to DynamoDB&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="695" as="sourcePoint" /><mxPoint x="680" y="695" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_37" value="&lt;b style=&quot;font-size:11px;&quot;&gt;15. 200 OK Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ document_id, metadata_revision: 2, updated_at, metadata: {...} }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="725" as="sourcePoint" /><mxPoint x="490" y="725" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_38" value="&lt;b style=&quot;font-size:11px;&quot;&gt;16. 200 OK (Updated)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Client receives updated revision&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="755" as="sourcePoint" /><mxPoint x="110" y="755" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="async_39" value="&lt;b style=&quot;font-size:11px; color:#880E4F;&quot;&gt;17. (Async) DDB Streams -&gt; OpenSearch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#666666;&quot;&gt;OpenSearch document projection refreshed with revision 2&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;dashPattern=2 2;rounded=0;strokeColor=#AD1457;strokeWidth=1.8;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="785" as="sourcePoint" /><mxPoint x="1250" y="785" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legend_40" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;OCC Guarantee:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;expected_metadata_revision prevents lost updates from concurrent edits&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Content Integrity:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Metadata updates do NOT change binary content or s3_version_id&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#AD1457; font-size:11px;&quot;&gt;Search Sync:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Asynchronously updates search index via DynamoDB Streams&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="1360" height="52" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
