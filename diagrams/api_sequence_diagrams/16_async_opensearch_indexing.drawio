<mxfile host="Electron" agent="Antigravity" version="24.7.5">
  <diagram id="seq-16-async-indexing" name="16. Async OpenSearch Indexing">
    <mxGraphModel dx="1400" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner_3" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:130px; vertical-align:middle;&quot;&gt;&lt;div style=&quot;background-color:#880E4F; color:#FFFFFF; font-weight:bold; font-size:13px; text-align:center; padding:6px 8px; border-radius:4px;&quot;&gt;ASYNC PIPELINE&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding-left:14px; vertical-align:middle;&quot;&gt;&lt;div style=&quot;font-size:17px; font-weight:bold; color:#232F3E;&quot;&gt;DynamoDB Streams → SQS → Indexer → OpenSearch Serverless&lt;/div&gt;&lt;div style=&quot;font-size:12px; color:#5A6B7C; margin-top:2px;&quot;&gt;CQRS Search Projection, S3 Audit Logging, Stale Revision Prevention &amp;amp; DLQ Resilience&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right; vertical-align:middle; width:340px;&quot;&gt;&lt;div style=&quot;background-color:#FCE4EC; border:1px solid #AD1457; border-radius:4px; padding:5px 10px; display:inline-block; font-size:11px; color:#880E4F;&quot;&gt;&lt;b&gt;Pattern:&lt;/b&gt; Eventual Consistency (Sub-Second)&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1.5;align=left;spacingLeft=15;spacingRight=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="68" as="geometry" /></mxCell>
        
        <!-- Lifeline 1: DynamoDB Table -->
        <mxCell id="part_ddb" value="&lt;b style=&quot;font-size:12px; color:#01579B;&quot;&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;doc-platform-mvp-control&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="140" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_ddb" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#0277BD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="93" y="65" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="line_ddb" value="" style="edgeStyle=none;dashed=1;html=1;strokeColor=#0277BD;strokeWidth=1.2;strokeOpacity=80;endArrow=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="157" as="sourcePoint" /><mxPoint x="110" y="760" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Lifeline 2: DynamoDB Streams -->
        <mxCell id="part_stream" value="&lt;b style=&quot;font-size:12px; color:#0D47A1;&quot;&gt;DynamoDB Streams&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;Shard-ordered CDC Stream&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="105" width="140" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_stream" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#1565C0;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="283" y="65" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="line_stream" value="" style="edgeStyle=none;dashed=1;html=1;strokeColor=#1565C0;strokeWidth=1.2;strokeOpacity=80;endArrow=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="157" as="sourcePoint" /><mxPoint x="300" y="760" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Lifeline 3: Stream Processor Lambda -->
        <mxCell id="part_worker" value="&lt;b style=&quot;font-size:12px; color:#E65100;&quot;&gt;StreamProcessor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;stream-processor.ts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#D35400;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="105" width="140" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_worker" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="473" y="65" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="line_worker" value="" style="edgeStyle=none;dashed=1;html=1;strokeColor=#D35400;strokeWidth=1.2;strokeOpacity=80;endArrow=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="157" as="sourcePoint" /><mxPoint x="490" y="760" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Lifeline 4: S3 Audit Bucket -->
        <mxCell id="part_audit" value="&lt;b style=&quot;font-size:12px; color:#1B5E20;&quot;&gt;Amazon S3 Audit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;doc-platform-mvp-audit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="105" width="140" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_audit" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2E7D32;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="663" y="65" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="line_audit" value="" style="edgeStyle=none;dashed=1;html=1;strokeColor=#2E7D32;strokeWidth=1.2;strokeOpacity=80;endArrow=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="157" as="sourcePoint" /><mxPoint x="680" y="760" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Lifeline 5: SQS Index Queue -->
        <mxCell id="part_sqs" value="&lt;b style=&quot;font-size:12px; color:#880E4F;&quot;&gt;Amazon SQS &amp;amp; DLQ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;doc-platform-mvp-index-queue&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="105" width="150" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_sqs" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#AD1457;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1"><mxGeometry x="858" y="65" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="line_sqs" value="" style="edgeStyle=none;dashed=1;html=1;strokeColor=#AD1457;strokeWidth=1.2;strokeOpacity=80;endArrow=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="157" as="sourcePoint" /><mxPoint x="875" y="760" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Lifeline 6: Indexer Lambda -->
        <mxCell id="part_indexer" value="&lt;b style=&quot;font-size:12px; color:#E65100;&quot;&gt;IndexerConsumer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;indexer.ts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#D35400;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="105" width="140" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_indexer" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1043" y="65" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="line_indexer" value="" style="edgeStyle=none;dashed=1;html=1;strokeColor=#D35400;strokeWidth=1.2;strokeOpacity=80;endArrow=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="157" as="sourcePoint" /><mxPoint x="1060" y="760" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Lifeline 7: OpenSearch Serverless -->
        <mxCell id="part_aoss" value="&lt;b style=&quot;font-size:12px; color:#004D40;&quot;&gt;OpenSearch Serverless&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;documents-v1 Collection&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="105" width="150" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_aoss" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#005276;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.opensearch_service;" vertex="1" parent="1"><mxGeometry x="1228" y="65" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="line_aoss" value="" style="edgeStyle=none;dashed=1;html=1;strokeColor=#00695C;strokeWidth=1.2;strokeOpacity=80;endArrow=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1245" y="157" as="sourcePoint" /><mxPoint x="1245" y="760" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Activations -->
        <mxCell id="act_ddb" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="104" y="180" width="12" height="340" as="geometry" /></mxCell>
        <mxCell id="act_worker" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="484" y="215" width="12" height="150" as="geometry" /></mxCell>
        <mxCell id="act_sqs" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="869" y="325" width="12" height="100" as="geometry" /></mxCell>
        <mxCell id="act_indexer" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1054" y="375" width="12" height="310" as="geometry" /></mxCell>

        <!-- Messages: DDB to Streams -->
        <mxCell id="msg_1" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. Commit Mutation Event (INSERT / MODIFY)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Emits NewImage &amp;amp; OldImage with shard sequence number&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0277BD;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="195" as="sourcePoint" /><mxPoint x="300" y="195" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Streams to StreamProcessor -->
        <mxCell id="msg_2" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Shard Batch Invocation (Event Source Mapping)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Invokes StreamProcessor Lambda with batch of up to 10 CDC records&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1565C0;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="225" as="sourcePoint" /><mxPoint x="490" y="225" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Frame: Parallel Fan-Out -->
        <mxCell id="frame_fanout" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;Parallel Fan-Out Execution&lt;/b&gt; &lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;[StreamProcessor asynchronously audits event &amp;amp; enqueues indexing job]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=180;height=22;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1.2;strokeOpacity=70;fillOpacity=30;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="440" y="250" width="460" height="110" as="geometry" /></mxCell>

        <!-- StreamProcessor to S3 Audit -->
        <mxCell id="msg_3" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3a. PutObject (Immutable Audit Log)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;audit/{date}/{doc_id}_{event_id}.json (SSE-KMS)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="280" as="sourcePoint" /><mxPoint x="680" y="280" as="targetPoint" /></mxGeometry></mxCell>

        <!-- StreamProcessor to SQS -->
        <mxCell id="msg_4" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3b. SendMessage (Index Job Notification)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ document_id, document_class, s3_version_id, metadata_revision, status }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#AD1457;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="330" as="sourcePoint" /><mxPoint x="875" y="330" as="targetPoint" /></mxGeometry></mxCell>

        <!-- SQS to Indexer -->
        <mxCell id="msg_5" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. SQS Event Source Batch Trigger&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Polls &amp;amp; invokes Indexer Lambda (batch: 5 messages, vis timeout: 30s)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#AD1457;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875" y="380" as="sourcePoint" /><mxPoint x="1060" y="380" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Indexer verifies current pointer in DynamoDB -->
        <mxCell id="msg_6" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. GetItem DOC#{document_id}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify latest authoritative pointer &amp;amp; guard against stale out-of-order events&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0277BD;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="420" as="sourcePoint" /><mxPoint x="110" y="420" as="targetPoint" /></mxGeometry></mxCell>

        <!-- DDB returns current pointer -->
        <mxCell id="ret_7" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Current Pointer Returned&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ current_metadata_revision, current_s3_version_id, status }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#0277BD;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="460" as="sourcePoint" /><mxPoint x="1060" y="460" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Frame: Conditional Projection Routing -->
        <mxCell id="frame_routing" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;Conditional Search Projection Routing&lt;/b&gt; &lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;[Inspects revision &amp;amp; status]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=240;height=22;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1.2;strokeOpacity=70;fillOpacity=30;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1000" y="490" width="310" height="200" as="geometry" /></mxCell>

        <!-- Indexer to OpenSearch (Upsert) -->
        <mxCell id="msg_8" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7a. [ACTIVE] Upsert Document Projection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;PUT /documents-v1/_doc/{id} (SigV4 Signed)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#00695C;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="525" as="sourcePoint" /><mxPoint x="1245" y="525" as="targetPoint" /></mxGeometry></mxCell>

        <!-- OpenSearch 200 OK -->
        <mxCell id="ret_9" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. 200 OK (Document Indexed)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Search projection immediately queryable&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1245" y="560" as="sourcePoint" /><mxPoint x="1060" y="560" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Indexer to OpenSearch (Soft Delete) -->
        <mxCell id="msg_10" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7b. [SOFT_DELETED] Delete Projection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;DELETE /documents-v1/_doc/{id}&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#C0392B;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="605" as="sourcePoint" /><mxPoint x="1245" y="605" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Stale Revision Drop -->
        <mxCell id="self_stale" value="&lt;b style=&quot;font-size:10px; color:#D35400;&quot;&gt;7c. [STALE REVISION] Drop Event&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#777777;&quot;&gt;If msg.revision &amp;lt; current_revision, discard&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#D35400;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1066" y="640" as="sourcePoint" /><mxPoint x="1066" y="675" as="targetPoint" /><Array as="points"><mxPoint x="1105" y="640" /><mxPoint x="1105" y="675" /></Array></mxGeometry></mxCell>

        <!-- Frame: DLQ Fallback -->
        <mxCell id="frame_dlq" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;Fault Tolerance &amp;amp; Dead-Letter Queue (DLQ)&lt;/b&gt; &lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;[If OpenSearch throws persistent errors, message is retried 3 times then moved to DLQ]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=280;height=22;fillColor=#FFF8E1;strokeColor=#F39C12;strokeWidth=1.2;strokeOpacity=70;fillOpacity=30;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="830" y="705" width="480" height="50" as="geometry" /></mxCell>
        <mxCell id="msg_dlq" value="&lt;b style=&quot;font-size:10.5px; color:#C0392B;&quot;&gt;9. Redrive Poison Message to DLQ (after 3 retries)&lt;/b&gt; &lt;span style=&quot;font-size:9.5px; color:#777777;&quot;&gt;→ CloudWatch DLQ Alarm&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;dashPattern=2 2;rounded=0;strokeColor=#C0392B;strokeWidth=1.5;fontSize=10.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="735" as="sourcePoint" /><mxPoint x="875" y="735" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Legend Footer -->
        <mxCell id="legend_footer" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Decoupled Projection:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;DynamoDB Streams &amp;amp; SQS isolate core transactions from search ingestion latency&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#D35400; font-size:11px;&quot;&gt;Out-of-Order Safety:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Indexer checks DynamoDB metadata_revision to prevent stale index overwrites&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Zero Blast Radius:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;OpenSearch downtime does NOT impact document uploads, downloads, or metadata updates&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="780" width="1300" height="52" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
