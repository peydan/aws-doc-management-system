        <mxCell id="msg_17" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. POST /search&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ filters: { customer_id: &#x27;IL-4492817&#x27;, branch_code: &#x27;TLV-04&#x27; }, sort, page_size: 20, cursor }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="195" as="sourcePoint" /><mxPoint x="580" y="195" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_18" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify search reader permissions&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="220" as="sourcePoint" /><mxPoint x="350" y="220" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_19" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Context verified&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="250" as="sourcePoint" /><mxPoint x="580" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_20" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke Search Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Search criteria body parsed&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="280" as="sourcePoint" /><mxPoint x="810" y="280" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="self_21" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;5. Build OpenSearch DSL Query&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#666666;&quot;&gt;bool: { must: [match_terms], filter: [term: {status: &#x27;ACTIVE&#x27;}, range: {...}] }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#D35400;strokeWidth=1.3;fontSize=10.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="816" y="305" as="sourcePoint" /><mxPoint x="816" y="340" as="targetPoint" /><Array as="points"><mxPoint x="855" y="305" /><mxPoint x="855" y="340" /></Array></mxGeometry></mxCell>
        <mxCell id="msg_22" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. POST /doc-platform-search-index/_search&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;SigV4 Signed Query (aoss:APIAccessAll, sort, search_after cursor)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="370" as="sourcePoint" /><mxPoint x="1110" y="370" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_23" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. Search Results JSON&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ hits: [ { _source: {...LoanMetadata} } ], total: 42, sort: [&#x27;1723...&#x27;] }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="420" as="sourcePoint" /><mxPoint x="810" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="frame_24" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;Search Engine Fallback (Graceful Degradation)&lt;/b&gt; &lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;[If OpenSearch is unreachable, Lambda returns 503 with retryable flag (Direct ID queries still operational)]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=140;height=22;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1.2;strokeOpacity=70;fillOpacity=40;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="520" y="455" width="680" height="85" as="geometry" /></mxCell>
        <mxCell id="ret_25" value="&lt;b style=&quot;font-size:11px;&quot;&gt;Alt 503 SEARCH_UNAVAILABLE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Error Envelope: Search engine temporarily unavailable, retryable: true&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#C0392B;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="495" as="sourcePoint" /><mxPoint x="580" y="495" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_26" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. 200 OK Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ items: [ LoanAgreementMetadata, ... ], next_cursor: [...], total: 42 }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="560" as="sourcePoint" /><mxPoint x="580" y="560" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_27" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. 200 OK (Search Hits)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Client displays formatted results grid &amp; pagination&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="600" as="sourcePoint" /><mxPoint x="120" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legend_28" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#00695C; font-size:11px;&quot;&gt;Security Filter:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Hardcoded filter { status: &#x27;ACTIVE&#x27; } automatically excludes soft-deleted records&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Pagination:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Cursor-based deep pagination (search_after) for scalable result traversal&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#D35400; font-size:11px;&quot;&gt;Resilience:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;OpenSearch isolation ensures search outages do NOT block direct ID reads/writes&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="1240" height="52" as="geometry" /></mxCell>
