        <mxCell id="fr_zip" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;Direct High-Speed Export Streaming&lt;/b&gt; &lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;[Bypasses APIGW/Lambda payload limitations; 3-day S3 auto-purge lifecycle]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=140;height=22;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1.2;strokeOpacity=70;fillOpacity=40;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="560" width="1270" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. POST /documents/batch-download&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Payload: { document_ids: [...], format: 'original'|'pdf', include_metadata: true }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="195" as="sourcePoint"/>
            <mxPoint x="580" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify Document.Reader clearance&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="220" as="sourcePoint"/>
            <mxPoint x="350" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Context verified&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="250" as="sourcePoint"/>
            <mxPoint x="580" y="250" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke Batch Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Concurrently process document ID batch&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="280" as="sourcePoint"/>
            <mxPoint x="810" y="280" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. Resolve Document Pointers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;BatchGetItem / GetItem DOC#{id} (verify status != SOFT_DELETED)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="310" as="sourcePoint"/>
            <mxPoint x="1040" y="310" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Active Pointers Resolved&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;s3_version_id, document_class, filename metadata&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1040" y="345" as="sourcePoint"/>
            <mxPoint x="810" y="345" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. Fetch Content &amp;amp; S3 Annotations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;GetObjectAnnotation + GetObject binary bytes; on-demand PDF conversion&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="380" as="sourcePoint"/>
            <mxPoint x="1250" y="380" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. Binary Buffers &amp;amp; Metadata&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Raw binary bytes + JSON annotations retrieved&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1250" y="415" as="sourcePoint"/>
            <mxPoint x="810" y="415" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. Package ZIP &amp;amp; PutObject exports/{batch_id}.zip&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;JSZip compression (Deflate) + manifest.json; generate 15-min presigned URL&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="450" as="sourcePoint"/>
            <mxPoint x="1250" y="450" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10. S3 Presigned URL Generated&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;https://.../exports/batch-xxx.zip?AWSAccessKeyId=...&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1250" y="485" as="sourcePoint"/>
            <mxPoint x="810" y="485" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="&lt;b style=&quot;font-size:11px;&quot;&gt;11. 200 OK (Batch Download Envelope)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ batch_id, zip_filename, download_url, expires_at, file_count, documents }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="510" as="sourcePoint"/>
            <mxPoint x="580" y="510" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="&lt;b style=&quot;font-size:11px;&quot;&gt;12. 200 OK Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Client receives signed URL for direct archive stream&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="535" as="sourcePoint"/>
            <mxPoint x="120" y="535" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" value="&lt;b style=&quot;font-size:11px;&quot;&gt;13. GET {download_url} (Direct S3 Export)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Client streams compressed ZIP archive directly from S3&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="600" as="sourcePoint"/>
            <mxPoint x="1250" y="600" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m14" value="&lt;b style=&quot;font-size:11px;&quot;&gt;14. 200 OK (application/zip)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Multi-document bundle + audit manifest.json delivered&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1250" y="660" as="sourcePoint"/>
            <mxPoint x="120" y="660" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Zero Egress Bottleneck:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Client streams multi-gigabyte ZIP bundles directly from S3 presigned URLs&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Audit Manifest:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Always bundles structured manifest.json auditing checksums and version lineage&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#D35400; font-size:11px;&quot;&gt;Transient Lifecycle:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;exports/ prefix automatically purges archives after 3 days to eliminate cost&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="750" width="1290" height="52" as="geometry"/>
        </mxCell>
