        <mxCell id="m1" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. POST /documents/{doc_id}/pages&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Binary Body: Donor PDF bytes; Headers: X-Position ('append'|'prepend'|'insert:N')&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="195" as="sourcePoint"/>
            <mxPoint x="580" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT &amp;amp; Role&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify Document.Writer or Admin clearance&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="220" as="sourcePoint"/>
            <mxPoint x="350" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Claims verified&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="250" as="sourcePoint"/>
            <mxPoint x="580" y="250" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke AddPages Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Pass donor bytes, position parameter, and document_id&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="280" as="sourcePoint"/>
            <mxPoint x="810" y="280" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. Resolve Active Pointer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;GetItem DOC#{document_id} (verify ACTIVE status, get current version)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="310" as="sourcePoint"/>
            <mxPoint x="1040" y="310" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Active Pointer Returned&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;current_application_version: 1, current_s3_version_id&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1040" y="340" as="sourcePoint"/>
            <mxPoint x="810" y="340" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. Fetch Target PDF Binary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;GetObject canonical key documents/{class}/{doc_id}&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="370" as="sourcePoint"/>
            <mxPoint x="1250" y="370" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. PDF Bytes Returned&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Target binary buffer received&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1250" y="400" as="sourcePoint"/>
            <mxPoint x="810" y="400" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. Splice Pages In-Memory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;pdf-lib merges donor pages; updates total page_count &amp;amp; SHA-256&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="435" as="sourcePoint"/>
            <mxPoint x="810" y="435" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10. PutObject S3 Canonical Binary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Uploads spliced binary producing brand-new immutable S3 VersionId&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="470" as="sourcePoint"/>
            <mxPoint x="1250" y="470" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="&lt;b style=&quot;font-size:11px;&quot;&gt;11. S3 VersionId Emitted&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Returns new VersionId: s3-ver-002&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1250" y="500" as="sourcePoint"/>
            <mxPoint x="810" y="500" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="&lt;b style=&quot;font-size:11px;&quot;&gt;12. PutObjectAnnotation (S3)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Attaches authoritative document-metadata with updated page_count&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="530" as="sourcePoint"/>
            <mxPoint x="1250" y="530" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" value="&lt;b style=&quot;font-size:11px;&quot;&gt;13. TransactWriteItems (OCC Commit)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Updates DOC#{id} pointer (v2) &amp;amp; creates VER#0000000002 lineage record&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="570" as="sourcePoint"/>
            <mxPoint x="1040" y="570" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m14" value="&lt;b style=&quot;font-size:11px;&quot;&gt;14. DynamoDB Commit Success&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;OCC revision lock satisfied; mutation emitted to DynamoDB Streams&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1040" y="605" as="sourcePoint"/>
            <mxPoint x="810" y="605" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m15" value="&lt;b style=&quot;font-size:11px;&quot;&gt;15. 201 Created Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ document_id, application_version: 2, s3_version_id, page_count }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="640" as="sourcePoint"/>
            <mxPoint x="580" y="640" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m16" value="&lt;b style=&quot;font-size:11px;&quot;&gt;16. 201 Created (Splicing Completed)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Client receives updated document version and page count&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="670" as="sourcePoint"/>
            <mxPoint x="120" y="670" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#E65100; font-size:11px;&quot;&gt;Authoritative Mutation:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Adding pages creates a new S3 WORM binary version; historical versions remain strictly immutable&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Automated Page Count:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Extracts total page count and recalculates cryptographic SHA-256 hash automatically&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Optimistic Concurrency:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;DynamoDB OCC guarantees sequential, non-colliding application_version increment&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="750" width="1290" height="52" as="geometry"/>
        </mxCell>
