        <mxCell id="fr_dlq" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;Fault Tolerance &amp;amp; Quarantine&lt;/b&gt; &lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;[On 3 consecutive failures, redrives to Enrichment DLQ and triggers CloudWatch Alarm]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=140;height=22;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1.2;strokeOpacity=70;fillOpacity=40;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="720" y="670" width="590" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. Document Mutation Committed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;New version VER# or metadata revision written to DynamoDB&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="195" as="sourcePoint"/>
            <mxPoint x="340" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Emit CDC Event (INSERT/MODIFY)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;DynamoDB Streams delivers NewImage record to StreamProcessor&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="225" as="sourcePoint"/>
            <mxPoint x="560" y="225" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Enqueue Enrichment Task&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;SendMessage { document_id, document_class, application_version, s3_key }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="260" as="sourcePoint"/>
            <mxPoint x="780" y="260" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Message Buffered in SQS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Enrichment queue isolates compute from stream velocity (DLQ on 3x fail)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="780" y="295" as="sourcePoint"/>
            <mxPoint x="1000" y="295" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. SQS EventSource Trigger&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Batch consume messages (batch size: 5)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="780" y="330" as="sourcePoint"/>
            <mxPoint x="1000" y="330" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Read S3 Content Excerpt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;GetObject binary excerpt + current S3 annotation&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1000" y="365" as="sourcePoint"/>
            <mxPoint x="1230" y="365" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. Invoke Bedrock Nova 2 Lite&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Extract domain attributes &amp;amp; scan for PII categories (National ID, Tax, etc.)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1000" y="405" as="sourcePoint"/>
            <mxPoint x="1230" y="405" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. Discovered Attributes &amp;amp; PII&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Returns extracted attributes &amp;amp; pii_categories: ['NATIONAL_ID', 'FINANCIAL']&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1230" y="445" as="sourcePoint"/>
            <mxPoint x="1000" y="445" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. Evaluate PII Non-Downgrade Ratchet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Union new PII categories; never downgrade contains_pii from true to false&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1000" y="480" as="sourcePoint"/>
            <mxPoint x="1000" y="480" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10. Update S3 Annotation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;PutObjectAnnotation with enriched metadata and updated revision&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1000" y="520" as="sourcePoint"/>
            <mxPoint x="120" y="520" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="&lt;b style=&quot;font-size:11px;&quot;&gt;11. DynamoDB Conditional OCC Commit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;UpdateItem DOC#{id}: metadata_revision = :expected + 1&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1000" y="560" as="sourcePoint"/>
            <mxPoint x="120" y="560" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="&lt;b style=&quot;font-size:11px;&quot;&gt;12. Write S3 Audit Record&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;PutObject audit/{date}/{doc_id}_enrichment.json (tokens, model, latency)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1000" y="600" as="sourcePoint"/>
            <mxPoint x="120" y="600" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" value="&lt;b style=&quot;font-size:11px;&quot;&gt;13. Delete SQS Message&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Successful enrichment acknowledges and removes message from queue&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1000" y="640" as="sourcePoint"/>
            <mxPoint x="780" y="640" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#702F8A; font-size:11px;&quot;&gt;Non-Downgrade Ratchet:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Guarantees automated enrichment cannot strip or weaken uploader security/PII policies&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;OCC DynamoDB Lock:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Conditional revision check ensures enrichment never overwrites concurrent human edits&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Audit Trail Persistence:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;All model metrics (prompt/completion tokens, latency) logged to S3 compliance store&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="750" width="1290" height="52" as="geometry"/>
        </mxCell>
      </root>
