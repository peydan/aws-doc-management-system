        <mxCell id="act_18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="104" y="180" width="12" height="540" as="geometry" /></mxCell>
        <mxCell id="act_19" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="484" y="200" width="12" height="490" as="geometry" /></mxCell>
        <mxCell id="act_20" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="674" y="280" width="12" height="390" as="geometry" /></mxCell>
        <mxCell id="msg_21" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. POST /documents&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Headers: X-Document-Metadata, X-Content-SHA256, Idempotency-Key, Binary Body&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="195" as="sourcePoint" /><mxPoint x="490" y="195" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_22" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Extract claims &amp; group memberships&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="220" as="sourcePoint" /><mxPoint x="300" y="220" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_23" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized (Writer/Admin)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;UserContext: { userId, roles, email }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="250" as="sourcePoint" /><mxPoint x="490" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_24" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke Upload Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Event with base64 encoded binary body&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="280" as="sourcePoint" /><mxPoint x="680" y="280" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="self_25" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;5. Validation &amp; SHA-256 Check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#666666;&quot;&gt;Check size ≤ 4 MiB, match SHA-256, validate JSON Schema v1&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#D35400;strokeWidth=1.3;fontSize=10.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="686" y="305" as="sourcePoint" /><mxPoint x="686" y="340" as="targetPoint" /><Array as="points"><mxPoint x="725" y="305" /><mxPoint x="725" y="340" /></Array></mxGeometry></mxCell>
        <mxCell id="msg_26" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. PutObject (Raw Document)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Key: documents/loan_agreement/{doc_id} (KMS SSE-KMS)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="370" as="sourcePoint" /><mxPoint x="870" y="370" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_27" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. 200 OK (S3 Versioning)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Headers: x-amz-version-id: s3_version_id&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="405" as="sourcePoint" /><mxPoint x="680" y="405" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_28" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. PutObjectAnnotation (document-metadata)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Attach named annotation JSON directly to S3 object version&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="440" as="sourcePoint" /><mxPoint x="870" y="440" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_29" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. 200 OK (ETag)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Annotation ETag returned&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="475" as="sourcePoint" /><mxPoint x="680" y="475" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_30" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10. commitDocumentCreation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;TransactWrite / PutItem DOC#{doc_id} &amp; VER#000001&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="510" as="sourcePoint" /><mxPoint x="1060" y="510" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_31" value="&lt;b style=&quot;font-size:11px;&quot;&gt;11. Transaction Committed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Metadata revision: 1, state: ACTIVE&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="550" as="sourcePoint" /><mxPoint x="680" y="550" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_32" value="&lt;b style=&quot;font-size:11px;&quot;&gt;12. 201 Created Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ document_id, application_version: 1, s3_version_id, status: &#x27;ACTIVE&#x27; }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="590" as="sourcePoint" /><mxPoint x="490" y="590" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_33" value="&lt;b style=&quot;font-size:11px;&quot;&gt;13. 201 Created (JSON)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Document registered &amp; immediately retrievable&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="625" as="sourcePoint" /><mxPoint x="110" y="625" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="async_34" value="&lt;b style=&quot;font-size:11px; color:#880E4F;&quot;&gt;14. (Async) DDB Streams -&gt; SQS -&gt; Indexer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#666666;&quot;&gt;Projection ingested to OpenSearch Serverless&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;dashed=1;dashPattern=2 2;rounded=0;strokeColor=#AD1457;strokeWidth=1.8;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="665" as="sourcePoint" /><mxPoint x="1250" y="665" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legend_35" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Payload Boundary:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Max 4 MiB payload directly through APIGW&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Storage:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;S3 Native Object Versioning + Authoritative Annotation&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#D35400; font-size:11px;&quot;&gt;Concurrency:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Idempotency-Key guarantees single mutation execution&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#AD1457; font-size:11px;&quot;&gt;Downstream:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Event-driven asynchronous search indexing&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="1360" height="52" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
