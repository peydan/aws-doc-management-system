        </mxCell>
        <mxCell id="legend" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Unified Audit Trail:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Fuses DynamoDB version pointers with immutable S3 WORM audit bucket records&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#702F8A; font-size:11px;&quot;&gt;LLM Telemetry:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Inspects model ID, token usage, latency, and PII safety ratchet history per document&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Non-Repudiation:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Guarantees regulatory non-repudiation for financial and compliance investigations&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
