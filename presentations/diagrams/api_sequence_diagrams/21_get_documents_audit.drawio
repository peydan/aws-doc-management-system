        <mxCell id="m1" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. GET /documents/{doc_id}/audit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Optional Query: ?limit=50&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="195" as="sourcePoint"/>
            <mxPoint x="580" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Bearer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify Document.Reader clearance&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="220" as="sourcePoint"/>
            <mxPoint x="350" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Context verified&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="350" y="250" as="sourcePoint"/>
            <mxPoint x="580" y="250" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke GetAudit Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;doc_id parameter passed&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="280" as="sourcePoint"/>
            <mxPoint x="810" y="280" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. Query Document Lineage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Query pk = DOC#{doc_id}, sk begins_with 'VER#' (historical version snapshots)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="310" as="sourcePoint"/>
            <mxPoint x="1040" y="310" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Version Lineage Records&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Returns chronological list of immutable versions and checksums&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1040" y="345" as="sourcePoint"/>
            <mxPoint x="810" y="345" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. List &amp;amp; Read S3 Audit Records&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;ListObjectsV2 prefix: audit/{date}/{doc_id}_*; read immutable CDC &amp;amp; LLM event JSONs&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="380" as="sourcePoint"/>
            <mxPoint x="1250" y="380" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. WORM Audit JSON Records&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Returns S3 mutation events, metadata diffs, user IDs, and LLM telemetry&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1250" y="420" as="sourcePoint"/>
            <mxPoint x="810" y="420" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. Aggregate &amp;amp; Correlate Audit Trail&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Combines DDB control plane lineage + S3 WORM records + Bedrock LLM metrics&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="460" as="sourcePoint"/>
            <mxPoint x="810" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10. 200 OK (Unified Audit Payload)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ document_id, versions: [...], events: [...], llm_enrichment_metrics: {...} }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
