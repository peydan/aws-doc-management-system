        <mxCell id="m12" value="&lt;b style=&quot;font-size:11px;&quot;&gt;12. Auto-Populate UI Form Inputs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Web Console fills input fields for user review prior to immutable WORM upload&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
