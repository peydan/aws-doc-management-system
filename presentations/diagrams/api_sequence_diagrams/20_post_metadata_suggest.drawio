        </mxCell>
        <mxCell id="m9" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. Validate &amp;amp; Normalize Attributes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Converts major currency to minor units; asserts Ajv type constraints&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
