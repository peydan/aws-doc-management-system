        </mxCell>
        <mxCell id="m8" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. Structured JSON Extraction&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Model extracts customer_id, loan_amount, currency, signed_date, branch&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
