        <mxCell id="m1" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. POST /metadata/suggest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Payload: { document_class: 'loan_agreement', text_excerpt / base64_content }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
