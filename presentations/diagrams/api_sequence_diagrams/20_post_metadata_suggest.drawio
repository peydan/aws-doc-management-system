        <mxCell id="legend" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#1E88E5; font-size:11px;&quot;&gt;Stateless Pre-Fill:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Extracts metadata before persistence; user reviews and edits fields prior to immutable commit&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Schema-Driven Constraints:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Enforces strict Ajv domain types and integer minor currency units during suggestion&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#702F8A; font-size:11px;&quot;&gt;High Accuracy:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Powered by Amazon Nova 2 Lite for zero-hallucination key-value extraction&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
