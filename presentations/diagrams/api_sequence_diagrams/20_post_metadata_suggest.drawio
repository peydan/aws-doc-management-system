          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. Load Target Schema Definition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Fetch loan_agreement-v1.json / compliance_retention-v1.json&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="310" as="sourcePoint"/>
            <mxPoint x="1250" y="310" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Schema Fields &amp;amp; Constraints&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Extract required properties, enums, and banking trait definitions&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
