            <mxPoint x="580" y="250" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke Suggest Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Process document excerpt for AI attribute pre-fill&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
