            <mxPoint x="120" y="195" as="sourcePoint"/>
            <mxPoint x="580" y="195" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Bearer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify user authentication &amp;amp; role clearance&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="220" as="sourcePoint"/>
            <mxPoint x="350" y="220" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Context valid&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1">
