        <mxCell id="part_dynamodb_14" value="&lt;b style=&quot;font-size:12px; color:#01579B;&quot;&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;doc-platform-mvp-control&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="105" width="140" height="52" as="geometry" /></mxCell>
        <mxCell id="awsicon_dynamodb_14" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#0277BD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1143" y="65" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="line_dynamodb_15" value="" style="edgeStyle=none;dashed=1;html=1;strokeColor=#0277BD;strokeWidth=1.2;strokeOpacity=80;endArrow=none;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="157" as="sourcePoint" /><mxPoint x="1160" y="730" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="act_16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="114" y="180" width="12" height="500" as="geometry" /></mxCell>
        <mxCell id="act_17" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="534" y="200" width="12" height="320" as="geometry" /></mxCell>
        <mxCell id="act_18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="744" y="270" width="12" height="230" as="geometry" /></mxCell>
        <mxCell id="msg_19" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. POST /documents/uploads&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ filename, content_length, checksum, metadata: {...} }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="195" as="sourcePoint" /><mxPoint x="540" y="195" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_20" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify role: Document.Writer / Document.Admin&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="220" as="sourcePoint" /><mxPoint x="330" y="220" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_21" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Context claims parsed&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="245" as="sourcePoint" /><mxPoint x="540" y="245" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_22" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke Init Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Pass session metadata &amp; upload descriptors&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="270" as="sourcePoint" /><mxPoint x="750" y="270" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="self_23" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;5. Generate UUIDs &amp; Validate Schema&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#666666;&quot;&gt;Generate document_id &amp; upload_id (01J4...), validate metadata schema&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#D35400;strokeWidth=1.3;fontSize=10.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="756" y="295" as="sourcePoint" /><mxPoint x="756" y="330" as="targetPoint" /><Array as="points"><mxPoint x="795" y="295" /><mxPoint x="795" y="330" /></Array></mxGeometry></mxCell>
        <mxCell id="msg_24" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Generate Presigned PUT URL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Key: documents/{class}/{doc_id}, ContentType, TTL: 900s&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="355" as="sourcePoint" /><mxPoint x="960" y="355" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_25" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. Presigned URL Generated&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;S3 Single-PUT upload signature (15 min expiry)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="390" as="sourcePoint" /><mxPoint x="750" y="390" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_26" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. PutItem (Upload Session)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;pk: UPLOAD#{upload_id}, sk: SESSION, state: INITIATED, TTL&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="425" as="sourcePoint" /><mxPoint x="1160" y="425" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_27" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. Session Saved&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;DynamoDB session registered&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="460" as="sourcePoint" /><mxPoint x="750" y="460" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_28" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10. 201 Created Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ upload_id, document_id, upload_url, required_headers, expires_at }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="490" as="sourcePoint" /><mxPoint x="540" y="490" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_29" value="&lt;b style=&quot;font-size:11px;&quot;&gt;11. 201 Created (Upload Session)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Client receives presigned S3 target&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="520" as="sourcePoint" /><mxPoint x="120" y="520" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="frame_30" value="&lt;b style=&quot;font-size:10.5px;&quot;&gt;Subsequent Direct S3 Data Transfer&lt;/b&gt; &lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;[Client pushes binary file directly to S3 bypassing API Gateway and Lambda limits]&lt;/span&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=140;height=22;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1.2;strokeOpacity=70;fillOpacity=40;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="950" height="150" as="geometry" /></mxCell>
        <mxCell id="msg_31" value="&lt;b style=&quot;font-size:11px;&quot;&gt;12. PUT {upload_url} (Direct Binary Stream)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Headers: Content-Type, Content-Length (Direct S3 connection)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="605" as="sourcePoint" /><mxPoint x="960" y="605" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_32" value="&lt;b style=&quot;font-size:11px;&quot;&gt;13. 200 OK (S3 Upload Complete)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;S3 creates native object version with SSE-KMS encryption&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="670" as="sourcePoint" /><mxPoint x="120" y="670" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legend_33" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;File Size:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Supports large files &gt; 4 MiB directly to S3&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#D35400; font-size:11px;&quot;&gt;Session Expiry:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;15-minute TTL enforced in S3 presigned URL &amp; DynamoDB&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Next Step:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Client must call /uploads/{upload_id}/complete to activate doc&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="1240" height="52" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
