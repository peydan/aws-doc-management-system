        <mxCell id="part_s3_12" value="&lt;b style=&quot;font-size:12px; color:#1B5E20;&quot;&gt;Amazon S3 Bucket&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#555555;&quot;&gt;Presigned Target&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="105" width="140" height="52" as="geometry" /></mxCell>
