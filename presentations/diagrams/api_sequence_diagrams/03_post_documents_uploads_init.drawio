        <mxCell id="banner_3" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:110px; vertical-align:middle;&quot;&gt;&lt;div style=&quot;background-color:#0277BD; color:#FFFFFF; font-weight:bold; font-size:14px; text-align:center; padding:6px 12px; border-radius:4px;&quot;&gt;POST&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;padding-left:14px; vertical-align:middle;&quot;&gt;&lt;div style=&quot;font-size:18px; font-weight:bold; color:#232F3E;&quot;&gt;/documents/uploads&lt;/div&gt;&lt;div style=&quot;font-size:12px; color:#5A6B7C; margin-top:2px;&quot;&gt;Initiate Direct Presigned S3 Upload Session (&gt; 4 MiB) &amp;nbsp;|&amp;nbsp; &lt;b style=&quot;color:#232F3E;&quot;&gt;Operation:&lt;/b&gt; &lt;code&gt;initiateDirectUpload&lt;/code&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right; vertical-align:middle; width:340px;&quot;&gt;&lt;div style=&quot;background-color:#FFF8E1; border:1px solid #F39C12; border-radius:4px; padding:5px 10px; display:inline-block; font-size:11px; color:#7D6608;&quot;&gt;&lt;b&gt;RBAC:&lt;/b&gt; Document.Writer, Document.Admin&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1.5;align=left;spacingLeft=15;spacingRight=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1240" height="68" as="geometry" /></mxCell>
