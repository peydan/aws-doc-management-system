        <mxCell id="act_17" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="574" y="200" width="12" height="450" as="geometry" /></mxCell>
        <mxCell id="act_18" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="804" y="280" width="12" height="350" as="geometry" /></mxCell>
        <mxCell id="msg_19" value="&lt;b style=&quot;font-size:11px;&quot;&gt;1. GET /documents/{doc_id}/versions/{ver}&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Path: document_id, version (e.g. 1), Optional: ?format=pdf&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="195" as="sourcePoint" /><mxPoint x="580" y="195" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_20" value="&lt;b style=&quot;font-size:11px;&quot;&gt;2. Validate JWT Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Verify read permissions&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="220" as="sourcePoint" /><mxPoint x="350" y="220" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_21" value="&lt;b style=&quot;font-size:11px;&quot;&gt;3. Authorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Context verified&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="250" as="sourcePoint" /><mxPoint x="580" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_22" value="&lt;b style=&quot;font-size:11px;&quot;&gt;4. Invoke Get Version Handler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;doc_id, version, and optional format passed&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="280" as="sourcePoint" /><mxPoint x="810" y="280" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_23" value="&lt;b style=&quot;font-size:11px;&quot;&gt;5. GetItem (Historical Version Item)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;pk: DOC#{document_id}, sk: VER#000001 (padded version)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="310" as="sourcePoint" /><mxPoint x="1040" y="310" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_24" value="&lt;b style=&quot;font-size:11px;&quot;&gt;6. Version Item&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;s3_key, s3_version_id, content_checksum, metadata_revision&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="345" as="sourcePoint" /><mxPoint x="810" y="345" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="msg_25" value="&lt;b style=&quot;font-size:11px;&quot;&gt;7. Check Derivative / Generate Presigned URL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;If format=pdf: resolve S3 cached derivative (or transcode); sign S3 GET URL&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="380" as="sourcePoint" /><mxPoint x="1250" y="380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_26" value="&lt;b style=&quot;font-size:11px;&quot;&gt;8. Version Presigned URL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Direct URL targeting specific historical S3 version (or cached PDF)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="415" as="sourcePoint" /><mxPoint x="810" y="415" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_27" value="&lt;b style=&quot;font-size:11px;&quot;&gt;9. 200 OK Response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;{ document_id, application_version: 1, s3_version_id, download_url, checksum }&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="460" as="sourcePoint" /><mxPoint x="580" y="460" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ret_28" value="&lt;b style=&quot;font-size:11px;&quot;&gt;10. 200 OK (Historical Version JSON)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px; color:#555555;&quot;&gt;Returns specific version metadata &amp; download URL (native or PDF)&lt;/span&gt;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=7;rounded=0;strokeColor=#2E7D32;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="500" as="sourcePoint" /><mxPoint x="120" y="500" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legend_29" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#2E7D32; font-size:11px;&quot;&gt;Immutability:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Historical version content in S3 is non-destructive &amp; immutable&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#0277BD; font-size:11px;&quot;&gt;Targeted Download:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;S3 VersionId parameter ensures exact historical bytes fetched&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 12px; vertical-align:top;&quot;&gt;&lt;b style=&quot;color:#D35400; font-size:11px;&quot;&gt;On-Demand PDF:&lt;/b&gt; &lt;span style=&quot;font-size:10px; color:#444444;&quot;&gt;Supports ?format=pdf for historical version conversion&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="1290" height="52" as="geometry" /></mxCell>
      </root>
