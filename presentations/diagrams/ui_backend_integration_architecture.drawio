        <mxCell id="box_legend" value="&lt;b style=&quot;font-size:13px; color:#1E293B;&quot;&gt;Architectural Patterns &amp;amp; Core Platform Invariants&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;margin:6px 0;&quot;&gt;&lt;div style=&quot;text-align:left; font-size:11px; color:#334155; line-height:1.4;&quot;&gt;&lt;b style=&quot;color:#0284C7;&quot;&gt;① Presentation Tier:&lt;/b&gt; Serverless Web Portal SPA served globally via Amazon CloudFront Edge CDN backed by Amazon S3 ($0 idle cost).&lt;br&gt;&lt;b style=&quot;color:#C026D3;&quot;&gt;② Identity &amp;amp; RBAC:&lt;/b&gt; Direct browser-to-Cognito SRP/USER_PASSWORD_AUTH; passes Bearer JWT to API Gateway authorizer.&lt;br&gt;&lt;b style=&quot;color:#16A34A;&quot;&gt;③ Tri-Partite WORM Authority:&lt;/b&gt; S3 holds immutable binary versions and authoritative JSON annotations; DynamoDB acts purely as O(1) control plane.&lt;br&gt;&lt;b style=&quot;color:#2563EB;&quot;&gt;④ Optimistic Concurrency Control:&lt;/b&gt; DynamoDB enforces &lt;code&gt;current_metadata_revision = :expected&lt;/code&gt; to guarantee zero write collisions.&lt;br&gt;&lt;b style=&quot;color:#702F8A;&quot;&gt;⑤ Amazon Bedrock AI Intelligence:&lt;/b&gt; Amazon Nova 2 Lite powers conversational assistance, stateless UI pre-filling, and async background PII enrichment with safety ratchets.&lt;br&gt;&lt;b style=&quot;color:#D97706;&quot;&gt;⑥ Event-Driven Async Projections:&lt;/b&gt; DynamoDB Streams CDC events are decoupled via SQS into OpenSearch Serverless and S3 compliance audit buckets.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="1040" width="2320" height="170" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
