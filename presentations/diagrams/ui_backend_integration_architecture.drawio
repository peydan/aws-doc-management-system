  <diagram id="ui-backend-integration-arch" name="UI &amp;amp; Backend Integration Architecture">
    <mxGraphModel dx="2600" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
