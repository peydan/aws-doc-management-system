        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 22px; color: #1E293B;&quot;&gt;AWS Document Management Platform — UI Application &amp;amp; Backend Integration Architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #64748B;&quot;&gt;Production Serverless Web Portal &amp;bull; Amazon CloudFront Edge CDN &amp;bull; Amazon S3 SPA Bucket &amp;bull; Amazon Cognito Direct Auth &amp;bull; API Gateway REST Tier &amp;bull; Amazon Bedrock AI &amp;bull; Direct S3 Presigned Uploads &amp;bull; DynamoDB OCC &amp;bull; OpenSearch Serverless&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
