        <mxCell id="box_fargate_task" value="&lt;b&gt;Amazon S3 SPA Bucket&lt;/b&gt; (Zero Idle Cost)&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Private Static Web Asset Store &amp;bull; OAC Restricted IAM Policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontColor=#0369A1;fontSize=12;" parent="1" vertex="1">
