        </mxCell>
        <mxCell id="node_streamlit_ui" value="&lt;b&gt;Serverless Web Portal (SPA)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;&lt;i&gt;index.html / app.js / styles.css&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;hr style=&quot;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#475569;&quot;&gt;&amp;bull; &lt;b&gt;Gated Cognito Login:&lt;/b&gt; 1-click role persona switcher&lt;br&gt;&amp;bull; &lt;b&gt;Tab 1: Document Viewer&lt;/b&gt; (Fetch, on-demand PDF, Batch ZIP &amp;amp; Page Splicing)&lt;br&gt;&amp;bull; &lt;b&gt;Tab 2: Ingestion &amp;amp; Upload&lt;/b&gt; (Direct Presigned PUT, Web Crypto SHA-256 &amp;amp; AI Pre-Fill)&lt;br&gt;&amp;bull; &lt;b&gt;Tab 3: OpenSearch Explorer&lt;/b&gt; (Faceted search, boolean DSL &amp;amp; cursor pagination)&lt;br&gt;&amp;bull; &lt;b&gt;Tab 4: AI Assistant&lt;/b&gt; (Amazon Bedrock Nova 2 Lite conversational chat &amp;amp; tool calling)&lt;br&gt;&amp;bull; &lt;b&gt;Tab 5: Metadata &amp;amp; Concurrency&lt;/b&gt; (Ajv validation &amp;amp; DynamoDB OCC revision locks)&lt;br&gt;&amp;bull; &lt;b&gt;Tab 6: Admin &amp;amp; Lifecycle&lt;/b&gt; (Soft-delete &amp;amp; Document restoration)&lt;br&gt;&amp;bull; &lt;b&gt;Tab 7: System Health&lt;/b&gt; (APIGW &amp;amp; Lambda runtime probes)&lt;br&gt;&amp;bull; &lt;b&gt;Tab 8: Active Session &amp;amp; JWT&lt;/b&gt; (Claims inspection &amp;amp; token viewer)&lt;br&gt;&amp;bull; &lt;b&gt;Tab 9: Audit Inspector&lt;/b&gt; (Unified compliance logs &amp;amp; Bedrock LLM metrics)&lt;br&gt;&amp;bull; &lt;b&gt;Tab 10: Cost Calculator&lt;/b&gt; (Interactive AWS multi-tier pricing model)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=1;align=center;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="90" y="340" width="360" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="node_api_client" value="&lt;b&gt;Browser Client SDK Layer&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;&lt;i&gt;Web Crypto &amp;amp; Fetch API&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;hr style=&quot;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#475569;&quot;&gt;&amp;bull; &lt;b&gt;Bearer JWT Injection:&lt;/b&gt; Authorization header&lt;br&gt;&amp;bull; &lt;b&gt;Client-Side Hashing:&lt;/b&gt; SHA-256 Web Crypto digest&lt;br&gt;&amp;bull; &lt;b&gt;XHR Upload Progress:&lt;/b&gt; Real-time streaming bar&lt;br&gt;&amp;bull; &lt;b&gt;Dynamic Schema Switching:&lt;/b&gt; Loan, Compliance, Security&lt;br&gt;&amp;bull; &lt;b&gt;CORS Support:&lt;/b&gt; Dedicated Lambda Preflight&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=1;align=center;verticalAlign=top;spacing=8;fontSize=11;" parent="1" vertex="1">
