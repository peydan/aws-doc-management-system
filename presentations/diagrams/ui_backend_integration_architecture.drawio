        <mxCell id="node_api_routes" value="&lt;b&gt;Protected REST Resources (/v1)&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left; font-size:9.5px; font-family:monospace; color:#334155; line-height:1.35;&quot;&gt;&amp;bull; POST /documents (Inline &amp;le; 4 MiB)&lt;br&gt;&amp;bull; POST /documents/uploads (Init direct)&lt;br&gt;&amp;bull; POST /uploads/{id}/complete (Finalize)&lt;br&gt;&amp;bull; DEL  /uploads/{id} (Abort upload)&lt;br&gt;&amp;bull; GET  /documents/{id} (Pointer &amp;amp; meta)&lt;br&gt;&amp;bull; GET  /documents/{id}/versions (List)&lt;br&gt;&amp;bull; POST /documents/{id}/versions (New)&lt;br&gt;&amp;bull; POST /documents/{id}/pages (PDF splice)&lt;br&gt;&amp;bull; GET  /documents/{id}/versions/{v}&lt;br&gt;&amp;bull; GET  /documents/{id}/metadata (S3)&lt;br&gt;&amp;bull; PATCH /documents/{id}/metadata (OCC)&lt;br&gt;&amp;bull; GET  /documents/{id}/download (Presigned)&lt;br&gt;&amp;bull; POST /documents/batch-download (ZIP)&lt;br&gt;&amp;bull; POST /documents/{id}/soft-delete&lt;br&gt;&amp;bull; POST /documents/{id}/restore&lt;br&gt;&amp;bull; POST /search (OpenSearch DSL)&lt;br&gt;&amp;bull; POST /metadata/suggest (AI Pre-Fill)&lt;br&gt;&amp;bull; POST /agent/chat (Nova 2 Lite AI)&lt;br&gt;&amp;bull; GET  /documents/{id}/audit (Audit &amp;amp; LLM)&lt;br&gt;&amp;bull; GET  /health (Operational Health)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=1;align=center;verticalAlign=top;spacing=6;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="560" y="715" width="300" height="260" as="geometry"/>
        </mxCell>
