{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-1234567890ab",
    "name": "AWS Document Management Platform MVP",
    "description": "Postman Collection showcasing the end-to-end capabilities of the AWS Document Management Platform MVP.\nIncludes inline upload, presigned direct upload, metadata updates with optimistic concurrency control, versioning, historical retrieval, search discovery, soft-delete, and restore.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://{{apiId}}.execute-api.us-east-1.amazonaws.com/v1",
      "type": "string"
    },
    {
      "key": "userPoolClientId",
      "value": "YOUR_COGNITO_CLIENT_ID",
      "type": "string"
    },
    {
      "key": "username",
      "value": "writer-user",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "uploadId",
      "value": "",
      "type": "string"
    },
    {
      "key": "uploadUrl",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Authenticate (AWS Cognito User Pool)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.AuthenticationResult && jsonData.AuthenticationResult.IdToken) {",
              "        var token = jsonData.AuthenticationResult.IdToken;",
              "        pm.collectionVariables.set('authToken', token);",
              "        console.log('Cognito Authentication Successful! Saved IdToken to {{authToken}}');",
              "    }",
              "} else {",
              "    console.warn('Cognito Auth returned status ' + pm.response.code + '. Falling back to existing {{authToken}} variable.');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-amz-json-1.1",
            "type": "text"
          },
          {
            "key": "X-Amz-Target",
            "value": "AWSCognitoIdentityProviderService.InitiateAuth",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"AuthFlow\": \"USER_PASSWORD_AUTH\",\n  \"ClientId\": \"{{userPoolClientId}}\",\n  \"AuthParameters\": {\n    \"USERNAME\": \"{{username}}\",\n    \"PASSWORD\": \"{{password}}\"\n  }\n}"
        },
        "url": {
          "raw": "https://cognito-idp.us-east-1.amazonaws.com/",
          "protocol": "https",
          "host": [
            "cognito-idp",
            "us-east-1",
            "amazonaws",
            "com"
          ],
          "path": [
            ""
          ]
        },
        "description": "Authenticates against AWS Cognito User Pool via InitiateAuth and automatically sets the returned JWT IdToken into collectionVariable {{authToken}}."
      },
      "response": []
    },
    {
      "name": "01 - System Health Check",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Checks the operational health status of the API Gateway and service."
      },
      "response": []
    },
    {
      "name": "02 - Upload Document (Inline Binary)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('documentId', jsonData.document_id);",
              "    console.log('Saved documentId:', jsonData.document_id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/pdf",
            "type": "text"
          },
          {
            "key": "X-Content-SHA256",
            "value": "59ecbec1412bb1aca640e9456f859d89fc199ab8ffe7c60fef2db8b054bd09f2",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "type": "text"
          },
          {
            "key": "X-Document-Metadata",
            "value": "",
            "type": "text",
            "description": "Base64-encoded loan agreement metadata JSON"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "%PDF-1.5 Sample Loan Agreement PDF Bytes for Demonstration..."
        },
        "url": {
          "raw": "{{baseUrl}}/documents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents"
          ]
        },
        "description": "Uploads a raw document up to 4 MiB inline. Captures documentId into collection variables."
      },
      "response": []
    },
    {
      "name": "03 - Get Current Document & Download URL",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}"
          ]
        },
        "description": "Retrieves the document control pointer, authoritative metadata annotation, and S3 presigned download URL."
      },
      "response": []
    },
    {
      "name": "04 - Update Metadata (Optimistic Revision 1 -> 2)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_metadata_revision\": 1,\n  \"reason\": \"CORRECTION\",\n  \"changes\": {\n    \"branch_code\": \"TLV-05\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}/metadata",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}",
            "metadata"
          ]
        },
        "description": "Updates metadata revision from 1 to 2 without creating a new content version."
      },
      "response": []
    },
    {
      "name": "05 - Update Metadata (Stale Attempt -> Expect 409)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_metadata_revision\": 1,\n  \"reason\": \"STALE_UPDATE\",\n  \"changes\": {\n    \"branch_code\": \"TLV-09\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}/metadata",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}",
            "metadata"
          ]
        },
        "description": "Demonstrates optimistic concurrency control. Rejects update with 409 METADATA_CONFLICT when expected_metadata_revision is stale."
      },
      "response": []
    },
    {
      "name": "06 - Create New Content Version (Version 2)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/pdf",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "%PDF-1.5 Updated Content Bytes for Version 2..."
        },
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}/versions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}",
            "versions"
          ]
        },
        "description": "Creates application version 2 for the document while keeping the same logical document ID."
      },
      "response": []
    },
    {
      "name": "07 - Get Historical Version 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}/versions/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}",
            "versions",
            "1"
          ]
        },
        "description": "Retrieves the exact S3 VersionId and presigned download URL for historical version 1."
      },
      "response": []
    },
    {
      "name": "08 - Initiate Presigned Direct Upload (>4 MiB)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('uploadId', jsonData.upload_id);",
              "    pm.collectionVariables.set('uploadUrl', jsonData.upload_url);",
              "    console.log('Saved uploadId:', jsonData.upload_id);",
              "    console.log('Saved uploadUrl:', jsonData.upload_url);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"document_class\": \"loan_agreement\",\n  \"filename\": \"large_mortgage_doc.pdf\",\n  \"content_type\": \"application/pdf\",\n  \"content_length\": 5242880,\n  \"checksum\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n  \"metadata\": {\n    \"document_type\": \"SIGNED_AGREEMENT\",\n    \"customer_id\": \"IL-9988776\",\n    \"loan_number\": \"LN-2026-99999\",\n    \"loan_amount_minor_units\": 50000000,\n    \"currency\": \"ILS\",\n    \"loan_type\": \"MORTGAGE\",\n    \"branch_code\": \"TLV-01\",\n    \"signed_date\": \"2026-07-20\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/documents/uploads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "uploads"
          ]
        },
        "description": "Initiates direct S3 single-PUT upload session and returns a short-lived S3 upload URL."
      },
      "response": []
    },
    {
      "name": "08b - Upload Binary Bytes to S3 Presigned URL",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/pdf",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "%PDF-1.5 Direct S3 Upload Demonstration Bytes (5MB simulated payload)..."
        },
        "url": {
          "raw": "{{uploadUrl}}",
          "host": [
            "{{uploadUrl}}"
          ]
        },
        "description": "Uploads raw binary bytes directly to Amazon S3 using the presigned PUT URL issued by Step 08."
      },
      "response": []
    },
    {
      "name": "09 - Complete Direct Upload",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/uploads/{{uploadId}}/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "uploads",
            "{{uploadId}}",
            "complete"
          ]
        },
        "description": "Verifies the direct S3 upload, creates the authoritative S3 metadata annotation, and activates the document."
      },
      "response": []
    },
    {
      "name": "10 - Search Documents (OpenSearch Discovery)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filters\": {\n    \"document_class\": \"loan_agreement\",\n    \"loan_type\": \"MORTGAGE\"\n  },\n  \"sort\": {\n    \"field\": \"created_at\",\n    \"direction\": \"desc\"\n  },\n  \"page_size\": 20\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/search",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "search"
          ]
        },
        "description": "Performs structured metadata search over current active documents in OpenSearch Serverless."
      },
      "response": []
    },
    {
      "name": "11 - Soft Delete Document",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}/soft-delete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}",
            "soft-delete"
          ]
        },
        "description": "Marks document status as SOFT_DELETED and removes it from OpenSearch discovery."
      },
      "response": []
    },
    {
      "name": "12 - Restore Document",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}/restore",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents",
            "{{documentId}}",
            "restore"
          ]
        },
        "description": "Restores soft-deleted document back to ACTIVE status and re-indexes in OpenSearch."
      },
      "response": []
    }
  ]
}