        </mxCell>

        <mxCell id="rbac_legend" value="&lt;b style=&quot;color: #D35400;&quot;&gt;Cognito User Groups (RBAC)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;doc_reader:&lt;/b&gt; Read &amp;amp; Search API&lt;br&gt;&lt;b&gt;doc_writer:&lt;/b&gt; Upload &amp;amp; Update Meta&lt;br&gt;&lt;b&gt;doc_admin:&lt;/b&gt; Soft Delete &amp;amp; Restore&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F39C12;strokeWidth=1;align=left;spacingLeft=12;" vertex="1" parent="c_client">
          <mxGeometry x="20" y="305" width="240" height="115" as="geometry" />
        </mxCell>

        <mxCell id="doc_schema_box" value="&lt;b style=&quot;color: #5B2C6F;&quot;&gt;Supported Document Schema&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;• &lt;b&gt;Document Class:&lt;/b&gt; &lt;code&gt;loan_agreement&lt;/code&gt;&lt;br&gt;• &lt;b&gt;MIME Types:&lt;/b&gt; PDF, TIFF, JPEG, Office&lt;br&gt;• &lt;b&gt;Direct Payload:&lt;/b&gt; &amp;le; 4 MiB (Inline API)&lt;br&gt;• &lt;b&gt;Large Upload:&lt;/b&gt; &amp;gt; 4 MiB (S3 Presigned)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECF7;strokeColor=#8E44AD;strokeWidth=1;align=left;spacingLeft=12;" vertex="1" parent="c_client">
          <mxGeometry x="20" y="440" width="240" height="200" as="geometry" />
        </mxCell>

