<mxfile host="Electron" agent="Antigravity" version="24.7.5">
  <diagram id="aws-docman-architecture" name="AWS Document Management Architecture">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 22px; color: #232F3E;&quot;&gt;AWS Document Management Platform — System Architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #5A6B7C;&quot;&gt;Serverless Architecture: Amazon API Gateway, AWS Lambda, Amazon S3 (Annotations), DynamoDB Streams, Amazon SQS, OpenSearch Serverless, Cognito &amp;amp; KMS&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1770" height="65" as="geometry" />
        </mxCell>

        <!-- ==================== AWS CLOUD OUTER CONTAINER ==================== -->
