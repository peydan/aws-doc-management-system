        <mxCell id="s3_audit" value="&lt;b style=&quot;color: #16A085; font-size: 13px;&quot;&gt;Amazon S3: Audit Trail Bucket&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#333333&quot;&gt;&lt;b&gt;Key Prefix:&lt;/b&gt; &lt;code&gt;audit/{YYYY}/{MM}/{DD}/{doc_id}-{ts}.json&lt;/code&gt;&lt;br&gt;&lt;b&gt;Payload:&lt;/b&gt; Immutable event records (Actor, Action, Prior/New State, Timestamp)&lt;br&gt;&lt;b&gt;Retention:&lt;/b&gt; Append-only compliance audit trail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A085;strokeWidth=1.5;align=left;spacingLeft=14;" vertex="1" parent="c_storage">
