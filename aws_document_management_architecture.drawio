        <mxCell id="sec_cognito" value="&lt;b style=&quot;color: #DD3522;&quot;&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#333333&quot;&gt;User Pool &amp;amp; App Client&lt;br&gt;JWT Tokens &amp;amp; Group Claims&lt;br&gt;RBAC Authorization&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD3522;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="c_security">
          <mxGeometry x="78" y="38" width="182" height="75" as="geometry" />
        </mxCell>

