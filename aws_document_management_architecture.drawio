        <mxCell id="client_direct_s3" value="&lt;b style=&quot;color: #2E7D32;&quot;&gt;Direct S3 Data Channel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#333333&quot;&gt;• Single-PUT Upload (&amp;gt;4 MiB)&lt;br&gt;• Presigned GET Content Download&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="c_client">
