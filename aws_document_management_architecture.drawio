        <mxCell id="icon_kms" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD3522;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="c_security">
          <mxGeometry x="20" y="140" width="48" height="48" as="geometry" />
        </mxCell>

        <mxCell id="sec_kms" value="&lt;b style=&quot;color: #DD3522;&quot;&gt;AWS KMS (CMK)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#333333&quot;&gt;Customer-Managed Key&lt;br&gt;SSE-KMS Encryption for S3, DDB, SQS, OpenSearch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD3522;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="c_security">
          <mxGeometry x="78" y="130" width="182" height="75" as="geometry" />
        </mxCell>

        <!-- IAM Icon + Card -->
        <mxCell id="icon_iam" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD3522;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="c_security">
          <mxGeometry x="20" y="235" width="48" height="48" as="geometry" />
        </mxCell>

        <mxCell id="sec_iam" value="&lt;b style=&quot;color: #DD3522;&quot;&gt;IAM Guardrails&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;• &lt;b&gt;Deny:&lt;/b&gt; &lt;code&gt;s3:DeleteObjectVersion&lt;/code&gt;&lt;br&gt;• Scoped Lambda Execution Roles&lt;br&gt;• OpenSearch Data Access Policy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD3522;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="c_security">
          <mxGeometry x="78" y="225" width="182" height="90" as="geometry" />
        </mxCell>

        <mxCell id="sec_audit_gov" value="&lt;b style=&quot;color: #27AE60;&quot;&gt;Compliance &amp;amp; Immutability&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;• S3 Object Versioning Enforced&lt;br&gt;• Mutable S3 Annotations on Versions&lt;br&gt;• Dedicated Encrypted Audit Bucket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#27AE60;strokeWidth=1;align=left;spacingLeft=12;" vertex="1" parent="c_security">
          <mxGeometry x="20" y="335" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- ==================== AWS REGION: API & COMPUTE ==================== -->
        <mxCell id="c_compute" value="&lt;b&gt;API &amp;amp; Serverless Compute Tier (AWS Lambda)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#FFF8E1;strokeColor=#ED7100;strokeWidth=1.5;fontColor=#7D5A00;rounded=1;arcSize=3;collapsible=0;" vertex="1" parent="c_aws_region">
          <mxGeometry x="20" y="45" width="440" height="1035" as="geometry" />
        </mxCell>

        <!-- API Gateway Icon + Card -->
        <mxCell id="icon_apigw" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="c_compute">
          <mxGeometry x="20" y="48" width="48" height="48" as="geometry" />
        </mxCell>

        <mxCell id="apigw" value="&lt;b style=&quot;color: #8C4FFF; font-size: 13px;&quot;&gt;Amazon API Gateway (REST API)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#333333&quot;&gt;• Cognito JWT Authorizer &amp;amp; RBAC Validation&lt;br&gt;• Binary Media Support (&lt;code&gt;*/*&lt;/code&gt;) for &amp;le; 4 MiB uploads&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;align=left;spacingLeft=12;" vertex="1" parent="c_compute">
          <mxGeometry x="78" y="40" width="342" height="70" as="geometry" />
        </mxCell>

        <!-- Command Lambda Icon + Card -->
        <mxCell id="icon_lambda_cmd" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="c_compute">
          <mxGeometry x="20" y="165" width="48" height="48" as="geometry" />
        </mxCell>

        <mxCell id="cmd_group" value="&lt;b style=&quot;color: #ED7100;&quot;&gt;Document Command Handlers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;• &lt;b&gt;POST /documents&lt;/b&gt; (Upload Inline &amp;le; 4 MiB)&lt;br&gt;• &lt;b&gt;POST /documents/direct-upload/initiate &amp;amp; complete&lt;/b&gt;&lt;br&gt;• &lt;b&gt;POST /documents/{id}/versions&lt;/b&gt; (Add new version)&lt;br&gt;• &lt;b&gt;PUT /documents/{id}/metadata&lt;/b&gt; (Optimistic locking)&lt;br&gt;• &lt;b&gt;DELETE /documents/{id}&lt;/b&gt; &amp;amp; &lt;b&gt;POST .../restore&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="c_compute">
          <mxGeometry x="78" y="125" width="342" height="135" as="geometry" />
        </mxCell>

        <!-- Query Lambda Icon + Card -->
        <mxCell id="icon_lambda_query" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="c_compute">
          <mxGeometry x="20" y="305" width="48" height="48" as="geometry" />
        </mxCell>

        <mxCell id="query_group" value="&lt;b style=&quot;color: #ED7100;&quot;&gt;Document Query Handlers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;• &lt;b&gt;GET /documents/{id}&lt;/b&gt; (Details &amp;amp; metadata)&lt;br&gt;• &lt;b&gt;GET /documents/{id}/content&lt;/b&gt; (Presigned GET URL)&lt;br&gt;• &lt;b&gt;GET /documents/{id}/versions&lt;/b&gt; (Version history registry)&lt;br&gt;• &lt;b&gt;GET /documents/{id}/metadata&lt;/b&gt; (Authoritative S3 Annotation)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="c_compute">
          <mxGeometry x="78" y="275" width="342" height="115" as="geometry" />
        </mxCell>

        <!-- Search Lambda Icon + Card -->
        <mxCell id="icon_lambda_search" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="c_compute">
          <mxGeometry x="20" y="425" width="48" height="48" as="geometry" />
        </mxCell>

        <mxCell id="search_group" value="&lt;b style=&quot;color: #ED7100;&quot;&gt;Search Query Handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10.5px;&quot; color=&quot;#333333&quot;&gt;• &lt;b&gt;POST /documents/search&lt;/b&gt;&lt;br&gt;• Translates API filters to OpenSearch Boolean Query&lt;br&gt;• Exact matches, range filters, date intervals, pagination cursor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="c_compute">
          <mxGeometry x="78" y="405" width="342" height="100" as="geometry" />
        </mxCell>

        <!-- Async Workers Container -->
        <mxCell id="async_workers_box" value="&lt;b style=&quot;color: #B7950B;&quot;&gt;Asynchronous &amp;amp; Event-Driven Processors&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#F1C40F;strokeWidth=1;align=center;verticalAlign=top;spacingTop=6;collapsible=0;" vertex="1" parent="c_compute">
          <mxGeometry x="15" y="525" width="410" height="490" as="geometry" />
        </mxCell>

        <!-- Stream Worker Icon + Card -->
        <mxCell id="icon_stream_worker" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="c_compute">
          <mxGeometry x="25" y="620" width="48" height="48" as="geometry" />
        </mxCell>

        <mxCell id="lambda_stream_worker" value="&lt;b style=&quot;color: #D35400;&quot;&gt;Background Stream Worker Lambda&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#333333&quot;&gt;&lt;b&gt;Trigger:&lt;/b&gt; DynamoDB Streams (&lt;code&gt;NEW_AND_OLD_IMAGES&lt;/code&gt;)&lt;br&gt;&lt;b&gt;Functions:&lt;/b&gt;&lt;br&gt;1. Processes document creation, version update, soft-delete&lt;br&gt;2. Emits indexing message to &lt;b&gt;SQS Index Queue&lt;/b&gt;&lt;br&gt;3. Writes structured audit record to &lt;b&gt;S3 Audit Bucket&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D35400;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="c_compute">
          <mxGeometry x="80" y="555" width="335" height="195" as="geometry" />
        </mxCell>

        <!-- Indexer Worker Icon + Card -->
        <mxCell id="icon_indexer_worker" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="c_compute">
          <mxGeometry x="25" y="855" width="48" height="48" as="geometry" />
        </mxCell>

        <mxCell id="lambda_indexer" value="&lt;b style=&quot;color: #D35400;&quot;&gt;SQS Indexer Consumer Lambda&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#333333&quot;&gt;&lt;b&gt;Trigger:&lt;/b&gt; SQS Index Queue (Batch size: 5-10)&lt;br&gt;&lt;b&gt;Functions:&lt;/b&gt;&lt;br&gt;1. Fetches authoritative metadata &amp;amp; current pointer&lt;br&gt;2. Upserts document projection into &lt;b&gt;OpenSearch Serverless&lt;/b&gt;&lt;br&gt;3. Deletes records on soft-delete; routes failed tasks to &lt;b&gt;DLQ&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D35400;strokeWidth=1.5;align=left;spacingLeft=12;" vertex="1" parent="c_compute">
          <mxGeometry x="80" y="775" width="335" height="215" as="geometry" />
        </mxCell>

        <!-- ==================== AWS REGION: STORAGE & CONTROL PLANE ==================== -->
        <mxCell id="c_storage" value="&lt;b&gt;Storage &amp;amp; Control Plane Tier&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#E8F8F5;strokeColor=#16A085;strokeWidth=1.5;fontColor=#0E6251;rounded=1;arcSize=3;collapsible=0;" vertex="1" parent="c_aws_region">
          <mxGeometry x="480" y="45" width="440" height="1035" as="geometry" />
        </mxCell>

        <!-- S3 Documents Icon + Card -->
        <mxCell id="icon_s3_docs" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#569E3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="c_storage">
          <mxGeometry x="20" y="90" width="48" height="48" as="geometry" />
        </mxCell>

        <mxCell id="s3_docs" value="&lt;b style=&quot;color: #27AE60; font-size: 13px;&quot;&gt;Amazon S3: Documents Bucket&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#333333&quot;&gt;&lt;b&gt;Key:&lt;/b&gt; &lt;code&gt;documents/{document_class}/{document_id}&lt;/code&gt;&lt;br&gt;&lt;b&gt;Immutable Content:&lt;/b&gt; Native S3 Object Versioning&lt;br&gt;&lt;b&gt;Authoritative Metadata:&lt;/b&gt; S3 Annotation (&lt;code&gt;document-metadata&lt;/code&gt;)&lt;br&gt;Mutable JSON attached to specific object VersionId&lt;br&gt;&lt;b&gt;Security:&lt;/b&gt; SSE-KMS, Bucket Policy denies Version Deletion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;strokeWidth=2;align=left;spacingLeft=14;" vertex="1" parent="c_storage">
          <mxGeometry x="78" y="40" width="342" height="165" as="geometry" />
        </mxCell>

        <!-- DynamoDB Icon + Card -->
        <mxCell id="icon_ddb" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#3B48CC;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="c_storage">
          <mxGeometry x="20" y="315" width="48" height="48" as="geometry" />
        </mxCell>

        <mxCell id="ddb_table" value="&lt;b style=&quot;color: #2980B9; font-size: 13px;&quot;&gt;Amazon DynamoDB: Control Plane&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#333333&quot;&gt;&lt;b&gt;Table:&lt;/b&gt; &lt;code&gt;docman_control_plane&lt;/code&gt; (Pay-per-request)&lt;br&gt;&lt;b&gt;Partition Key / Sort Key:&lt;/b&gt; &lt;code&gt;PK&lt;/code&gt; / &lt;code&gt;SK&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Current Pointer:&lt;/b&gt; &lt;code&gt;DOC#{id}&lt;/code&gt; (Current VersionId, rev, status)&lt;br&gt;• &lt;b&gt;Version Registry:&lt;/b&gt; &lt;code&gt;DOC#{id}#VER#{vid}&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Concurrency Tag:&lt;/b&gt; Optimistic Locking (&lt;code&gt;metadataRevision&lt;/code&gt;)&lt;br&gt;• &lt;b&gt;Idempotency:&lt;/b&gt; Tokens &amp;amp; Schema Version metadata&lt;br&gt;• &lt;b&gt;Outbox Records:&lt;/b&gt; Change events with CDC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2980B9;strokeWidth=2;align=left;spacingLeft=14;" vertex="1" parent="c_storage">
          <mxGeometry x="78" y="225" width="342" height="230" as="geometry" />
        </mxCell>

        <!-- DynamoDB Streams Icon + Card -->
        <mxCell id="icon_ddb_stream" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#3B48CC;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb_streams;" vertex="1" parent="c_storage">
          <mxGeometry x="20" y="490" width="48" height="48" as="geometry" />
        </mxCell>

        <mxCell id="ddb_stream" value="&lt;b style=&quot;color: #3498DB;&quot;&gt;DynamoDB Streams (CDC Engine)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#555555&quot;&gt;Stream View: &lt;code&gt;NEW_AND_OLD_IMAGES&lt;/code&gt;&lt;br&gt;Emits real-time ordered change stream for all record modifications&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#3498DB;strokeWidth=1.5;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="c_storage">
